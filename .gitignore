# Secrets — never commit
.env
.env.*
!.env.example
gcs-service.json
*-service.json

# Per-brand isolated state (Shopify OAuth token cache lives here)
.home/

# Built binaries (rebuilt on demand from the Cyclone source)
bin/.build/

# Shopify CLI local state (the theme code itself IS committed under theme/)
.shopify/
theme/.shopify/
theme/node_modules/

# direnv
.direnv/

# macOS / OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Logs & temp
*.log
tmp/
*.tmp

# Go artifacts
*.test
*.out
coverage.*

# Workspace scratch (Conductor agent collaboration dir)
.context/

# Personal Conductor overrides (settings.local.toml IS committed shared config;
# settings.local.json is meant to stay local per .git/info/exclude convention)
.conductor/settings.local.json
