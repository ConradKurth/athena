# ─────────────────────────────────────────────────────────────────────────────
# Athena CLI + capability credentials.
# Copy to `.env` (gitignored) and fill in. docs/CREDENTIALS.md explains where
# each value comes from and which are REUSED from Cyclone vs CREATED for Athena.
# Exported values take precedence over anything a CLI reads from a local .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Brand identity (CREATE for Athena) ──────────────────────────────────────
ATHENA_DOMAIN=athena-example.com        # bare domain; used for GSC site + image/SEO context
ATHENA_GA4_PROPERTY=                     # numeric GA4 property id, no "properties/" prefix

# ── Shopify (CREATE for Athena: new store + OAuth app) ───────────────────────
MYSHOPIFY_DOMAIN=your-athena-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative to OAuth — legacy custom-app token:
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_SCOPES=read_content,write_content,read_products,write_products,read_files,write_files
# Official Shopify CLI theme auth (for `shopify-theme pull/dev`). Optional —
# leave blank to use interactive browser login instead. Theme Access app password:
SHOPIFY_CLI_THEME_TOKEN=

# ── Gmail outreach (CREATE: Athena GCP service account + impersonation) ───────
GMAIL_SA_KEY=./gcs-service.json          # relative paths resolve against the repo root
GMAIL_IMPERSONATE=you@athena-domain.com  # MUST differ from conrad@cyclonepods.com
GMAIL_OUTREACH_ADDRESS=                   # CAN-SPAM footer (optional)

# ── Account-scoped keys (REUSE Cyclone's — one key works for any brand) ───────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
GOOGLE_AI_API_KEY=                        # Gemini / nanobanana image gen (reuse Cyclone's)
# DataForSEO — account-scoped, reuse Cyclone's creds (the dataforseo MCP reads these):
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# ── Wrapper behavior ─────────────────────────────────────────────────────────
CYCLONE_DIR=/Users/conrad/workspace/cyclone/cyclone   # Cyclone source the CLIs build from
ATHENA_AUTO_PULL=1                         # 1 = daily best-effort `git pull` before build, 0 = off
