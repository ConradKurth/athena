        "b1_hero": {"type": "hero", "settings": {"eyebrow": "For families & caregivers", "heading": "Incontinence care for aging parents:", "heading_accent": "a guide for families.", "text": "<p>Learn how UraGuard® can help protect your loved ones, with one simple layer of hygiene between changes.</p>", "image": "shopify://shop_images/incontinence-care-for-elderly.png", "image_alt": "A caregiver with an older woman", "button_label": "Shop UraGuard®", "button_link": "shopify://products/athena-uraguard-liner", "button2_label": "Get the free caregiver guide", "button2_link": "#cg-guide", "ratio": "natural"}},
        "b2_checklist": {"type": "checklist", "settings": {"bg": "paper", "eyebrow": "Is this you?", "heading": "Does someone you love rely on caregivers to change their incontinence products?", "intro": "<p>Whether they live in:</p>", "items": "An assisted living facility\nA nursing home\nA long-term care facility\nA memory care community\nA skilled nursing facility", "outro": "UraGuard® can add a simple layer of hygiene protection between changes.", "image": "shopify://shop_images/Incontinence-care-for-the-elderly.webp", "image_alt": "Incontinence care for the elderly"}},
        "b3_intro": {"type": "intro", "settings": {"bg": "blush", "eyebrow": "Peace of mind", "heading": "Protect your loved one with UraGuard®", "text": "<p>UraGuard® Shield is designed to reduce contact with moisture and bacteria commonly found in incontinence products. It helps your loved one maintain better hygiene while giving you peace of mind.</p><p>UraGuard® was inspired by the stories of patients and families. All too often, family members worry that their loved one isn’t changed in a timely fashion, and about prolonged exposure to moisture and bacteria while sitting in a soiled brief.</p><p>UraGuard® provides an added layer of protection to support your loved one’s hygiene and comfort, while easing your concerns.</p>"}},
        "b4_text_image": {"type": "text_image", "settings": {"bg": "paper", "eyebrow": "Where it sits", "heading": "A barrier where it matters most", "text": "<p>UraGuard® sits directly under the urethra, the opening that carries urine out of the body. When someone waits in a soiled brief, their skin rests against the moisture and bacteria held in it.</p><p>UraGuard® places a physical barrier there, helping reduce their exposure until the next change.</p>", "image": "shopify://shop_images/Screenshot_2025-04-02_at_9.30.45_AM.jpg", "image_alt": "Where the UraGuard shield sits inside a brief", "ratio": "natural", "button_label": "Shop now", "button_link": "shopify://products/athena-uraguard-liner"}},
        "b5_text_image": {"type": "text_image", "settings": {"bg": "white", "eyebrow": "Day and night", "heading": "Continuous protection", "text": "<p>UraGuard® provides continuous protection, day and night. Designed to be lightweight and comfortable, the shield offers effortless, around-the-clock protection, giving you peace of mind at all times.</p>", "image": "shopify://shop_images/continuous-protection-with-uraguard.png", "image_alt": "Continuous protection with UraGuard", "image_right": true, "ratio": "natural"}},
        "b6_uti": {"type": "uti", "settings": {"bg": "paper", "eyebrow": "Why timely changes matter", "heading": "Time in a wet brief can lead to a UTI.", "text": "<p>Absorbent products hold urine against the skin until the next change. In a year-long study of nursing-home residents, those who wore absorbent pads had far more urinary tract infections.</p>", "stat_note": "Every hour between changes counts."}},
        "b7_stat96": {"type": "stat96", "settings": {"bg": "blush", "eyebrow": "Independent lab result", "heading": "less surface bacteria in laboratory testing†", "text": "In laboratory testing, UraGuard® technology reduced surface bacteria by 96%.† Independently tested over 8 hours using the AATCC 100 method, compared with a standard diaper.", "button_label": "Shop UraGuard®", "button_link": "shopify://products/athena-uraguard-liner"}},
        "b8_video": {"type": "video", "settings": {"bg": "white", "eyebrow": "See it in action", "heading": "See how UraGuard® works", "video": "shopify://files/videos/UraGuard Comparison Video Updated.mp4"}},
        "b9_product": {"type": "product", "settings": {"eyebrow": "Helping you help the ones you love", "heading": "Easy to add at every change", "text": "No extra work for caregivers: place a fresh shield inside the brief she already wears.", "ticks": "Works in the brief she already wears\nNo extra work at changes\nDelivered to her door", "button_label": "Shop UraGuard®"}}
      },
