            "open": false
          }
        },
        "b18": {
          "type": "qa",
          "settings": {
            "q": "Does UraGuard® offer a satisfaction guarantee?",
            "a": "<p>Yes! We stand behind the quality of our products. If you’re not completely satisfied, contact our customer support team within 30 days for a hassle-free refund or exchange.</p>",
            "open": false
          }
        },
