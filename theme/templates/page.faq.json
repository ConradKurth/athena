          }
        },
        "6c6c8546-4be8-47e9-8694-d542109d388e": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Does UraGuard® reduce my exposure to bacteria?",
            "content": "<p><strong>UraGuard® is designed to help reduce your exposure to bacteria inside incontinence products. </strong>Our patent-pending UraGuard® technology acts as a physical barrier placed beneath the urethra, helping reduce bacterial contact with the urethral area. This added layer of protection works within your standard incontinence product to support a cleaner, more comfortable environment.</p>",
            "page": "",
            "icon": "none"
          }
        },
        "18a26329-3e89-409b-b175-cad7e9531a44": {
