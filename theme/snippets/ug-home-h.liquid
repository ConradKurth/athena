{%- assign s1 = images['uraguard-step-1-peel.jpg'] | default: section.settings.step_1 -%}
{%- assign s2 = images['uraguard-step-2-place.jpg'] | default: section.settings.step_2 -%}
{%- assign s3 = images['uraguard-step-3-press.jpg'] | default: section.settings.step_3 -%}
{%- assign s4 = images['uraguard-step-4-remove.jpg'] | default: section.settings.step_4 -%}
<section class="sec how3" id="ug-how">
  <div class="w">
    <div class="head">
      <div>
        <span class="lbl">How to use it</span>
        <h2 class="h2">Four simple steps, every change</h2>
        <p class="sub">UraGuard® goes inside the disposable brief, pull-up or adult diaper you already use.</p>
      </div>
      <a class="tlink" href="/pages/instructions-for-use">Full instructions</a>
    </div>
    <ol class="steps steps4 swipe">
      <li class="card step"><div class="im">{%- if s1 != blank -%}{{ s1 | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'A hand peeling the release paper off the back of a UraGuard shield' }}{%- endif -%}</div><b>1. Peel</b><span>Remove the release paper from the adhesive backing.</span></li>
      <li class="card step"><div class="im">{%- if s2 != blank -%}{{ s2 | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'A hand placing the UraGuard shield, blue panel up, inside the front of a pink pull-up brief' }}{%- endif -%}</div><b>2. Place</b><span>Position it in the front of your brief, adhesive side down. The blue panel faces up, right under where urine leaves the body, with the wide end toward the front.</span></li>
      <li class="card step"><div class="im">{%- if s3 != blank -%}{{ s3 | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'A hand gently pressing the shield flat inside the brief' }}{%- endif -%}</div><b>3. Press</b><span>Gently press to secure so it stays in place, then wear as usual.</span></li>
      <li class="card step"><div class="im">{%- if s4 != blank -%}{{ s4 | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'A hand lifting a used shield out of the brief' }}{%- endif -%}</div><b>4. Remove</b><span>Remove after use and throw it in the trash. Do not flush. Use a fresh shield at every change.</span></li>
    </ol>
    <p class="swipe-hint">Swipe to see all four steps</p>
    <div class="brands"><span>Works inside</span><span class="b">DEPEND®</span><span class="b">TENA®</span><span class="b">ALWAYS DISCREET®</span><span class="b">PREVAIL®</span><span class="b">TRANQUILITY®</span><span class="b">ABENA®</span><span class="b">STORE BRANDS</span></div>
  </div>
  <style>
    .ug .steps.steps4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
    .ug .steps.steps4 .im{aspect-ratio:7/8;overflow:hidden;border-radius:16px;background:#f8ebe7}
    .ug .steps.steps4 .im img{width:100%;height:100%;object-fit:cover;display:block}
    .ug .steps.steps4 .im::before{display:none}
    .ug .steps.steps4 b{display:block;margin-top:14px;font-size:18px;color:#3d1f35}
    .ug .steps.steps4 span{display:block;margin-top:4px;font-size:15px;line-height:1.5;color:#5b4155}
    @media (max-width:989px){.ug .steps.steps4{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media (max-width:749px){.ug .steps.steps4{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;padding-bottom:6px}.ug .steps.steps4 > li{flex:0 0 72%;scroll-snap-align:start}}
  </style>
</section>