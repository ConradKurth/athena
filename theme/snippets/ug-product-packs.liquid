{%- comment -%} Homepage-style pack cards for the product page. Drives the theme's own variant picker so price, subscriptions and add to cart keep working. {%- endcomment -%}
<div class="ugp-packs-src" hidden>
  <div class="buy" id="ugp-packs">
    <fieldset>
      <legend>Choose your pack</legend>
      {%- for variant in product.variants -%}
        {%- assign parts = variant.title | split: ' · ' -%}
        {%- assign count_txt = parts[0] | split: ' (' | first -%}
        {%- assign per_txt = parts[0] | split: '(' | last | remove: ')' -%}
        <label class="pk">
          {%- if forloop.index == 2 -%}<span class="flag">Most popular</span>{%- endif -%}
          <input type="radio" name="ugp-pack" value="{{ variant.option1 | escape }}" {% unless variant.available %}disabled{% endunless %}>
          <span class="t"><strong>{{ count_txt }}</strong><small>{%- if parts[1] -%}{{ parts[1] }}{%- endif -%}</small></span>
          <span class="pr">{{ variant.price | money_without_trailing_zeros }}{%- if per_txt != parts[0] -%}<small>{{ per_txt }}</small>{%- endif -%}</span>
        </label>
      {%- endfor -%}
    </fieldset>
  </div>
</div>
<style>
  .ugp-packs-host{margin:10px 0 18px;background:transparent;overflow:visible}
  .ugp-packs-host .buy fieldset{margin:0;padding:12px 0 0;border:0;display:grid;gap:14px;overflow:visible;min-width:0}
  .ugp-packs-host .buy legend{display:block;float:none;width:auto;font-family:'Nunito Sans',sans-serif;font-weight:800;color:#3d1f35;font-size:16px;margin:0 0 4px;padding:0;text-align:left}
  .ugp-packs-host label.pk{position:relative!important;display:grid!important;grid-template-columns:24px minmax(0,1fr) auto!important;gap:14px!important;align-items:center!important;justify-content:stretch!important;text-align:left!important;padding:16px 18px!important;margin:0!important;border-radius:18px!important;background:#fff!important;border:1.5px solid #ead6dc!important;box-shadow:none!important;overflow:visible!important;cursor:pointer;width:100%!important;min-height:0!important;height:auto!important;font-family:'Nunito Sans',sans-serif!important;color:#3d1f35!important}
  .ugp-packs-host label.pk:has(input:checked){border-color:#a64a63!important;box-shadow:0 0 0 3px rgba(166,74,99,.14)!important}
  .ugp-packs-host label.pk input{-webkit-appearance:radio!important;appearance:auto!important;position:static!important;opacity:1!important;clip:auto!important;width:20px!important;height:20px!important;margin:0!important;padding:0!important;accent-color:#a64a63;display:block!important;pointer-events:none}
  .ugp-packs-host label.pk .t{display:block!important;text-align:left!important}
  .ugp-packs-host label.pk .t strong{display:block;color:#3d1f35;font-size:17px;font-weight:800;line-height:1.3}
  .ugp-packs-host label.pk .t small{display:block;font-size:14px;color:#7a6274;font-weight:400;margin-top:2px}
  .ugp-packs-host label.pk .pr{display:block!important;text-align:right!important;font-weight:800;color:#3d1f35;font-size:20px;line-height:1.2;white-space:nowrap}
  .ugp-packs-host label.pk .pr small{display:block;font-weight:700;font-size:13px;color:#2a7a83;margin-top:2px}
  .ugp-packs-host label.pk .flag{position:absolute!important;top:-11px!important;right:18px!important;left:auto!important;background:#a64a63;color:#fff;font-size:12px;font-weight:800;line-height:1;padding:5px 11px;border-radius:999px;white-space:nowrap}
  .ugp-picker-hidden{display:none!important}
</style>
<script>
  (function(){
    var src=document.querySelector('.ugp-packs-src');if(!src)return;
    var packs=src.querySelector('#ugp-packs');
    var vals=[].map.call(packs.querySelectorAll('input'),function(i){return i.value;});
    function themeInputs(){return [].filter.call(document.querySelectorAll('input[type=radio]'),function(r){return !packs.contains(r)&&vals.indexOf(r.value)>-1;});}
    function init(){
      var rs=themeInputs();if(!rs.length)return false;
      var picker=rs[0].parentElement;
      while(picker&&!rs.every(function(r){return picker.contains(r);}))picker=picker.parentElement;
      if(!picker)return false;
      var host=document.createElement('div');host.className='ug ugp-packs-host';host.appendChild(packs);
      picker.parentNode.insertBefore(host,picker);picker.classList.add('ugp-picker-hidden');src.remove();
      var oname={{ product.options.first | json }};var lvl=picker.parentElement;for(var k=0;k<3&&lvl;k++){[].forEach.call(lvl.children,function(c){if(c===host||c===picker||c.contains(host))return;var tx=(c.textContent||'').trim();if(tx.length<160&&oname&&tx.indexOf(oname)===0)c.classList.add('ugp-picker-hidden');});lvl=lvl.parentElement;}
      function sync(){var c=themeInputs().filter(function(r){return r.checked;})[0];if(!c)return;[].forEach.call(packs.querySelectorAll('input'),function(i){i.checked=(i.value===c.value);});}
      sync();
      packs.addEventListener('change',function(e){var v=e.target.value;var t=themeInputs().filter(function(r){return r.value===v;})[0];if(t&&!t.checked){t.click();}});
      document.addEventListener('change',function(e){if(e.target&&!packs.contains(e.target))sync();});
      return true;
    }
    if(!init())document.addEventListener('DOMContentLoaded',init);
  })();
</script>