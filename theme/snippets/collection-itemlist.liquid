{%- comment -%}
  CollectionPage + ItemList JSON-LD for a collection's products (SEO structured data).
  Renders nothing if the collection has no products.
  Usage: {% render 'collection-itemlist', collection: collection %}
{%- endcomment -%}
{%- if collection and collection.products.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      {%- if collection.description != blank %}
      "description": {{ collection.description | strip_html | truncate: 300 | json }},
      {%- endif %}
      "url": {{ request.origin | append: collection.url | json }},
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count | default: collection.products.size }},
        "itemListElement": [
          {%- for product in collection.products limit: 30 -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "url": {{ request.origin | append: product.url | json }},
            "name": {{ product.title | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}
