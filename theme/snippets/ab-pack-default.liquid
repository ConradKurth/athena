{%- comment -%}
  A/B test (started 2026-10): which pack the PDP preselects. Cell a = 30-pack (theme default), b = 60-pack.
  The cell persists per browser (localStorage), is written to the cart as `_ab_pack_default` (lands on the
  order as a hidden attribute) and sent to GA4 as event `ab_pack_default_a` / `ab_pack_default_b` so users
  per cell can be counted. Visitors whose URL already picks a variant are left alone.
  Cell b is served by redirecting to ?variant=<60-pack> (one fast reload, same as a pack-card click).
  Readout: .context/data/ab_pack_report.py. Remove this snippet and its render after the test.
  (Preview theme: rendered from sections/ug-product-story.liquid instead of main-product.liquid.)
{%- endcomment -%}
{%- if product.handle == 'athena-uraguard-liner' -%}
  {%- assign sixty_id = '' -%}
  {%- for v in product.variants -%}{%- if v.option1 contains '60 ' -%}{%- assign sixty_id = v.id -%}{%- endif -%}{%- endfor -%}
  <script>
    (function () {
      var KEY = 'ug_ab_pack_default', cell;
      try {
        cell = localStorage.getItem(KEY);
        if (cell !== 'a' && cell !== 'b') {
          cell = Math.random() < 0.5 ? 'a' : 'b';
          localStorage.setItem(KEY, cell);
        }
      } catch (e) {
        return; // storage blocked: leave this visitor out of the test
      }
      // Cell b with no variant in the URL: redirect to the 60-pack, like a pack-card click does in this
      // theme (it reloads with ?variant=). utm/fbclid params are kept; tracking runs after the redirect lands.
      if (cell === 'b' && '{{ sixty_id }}' && !/[?&]variant=/.test(location.search)) {
        var url = new URL(location.href);
        url.searchParams.set('variant', '{{ sixty_id }}');
        location.replace(url.toString());
        return;
      }
      if (window.gtag) gtag('event', 'ab_pack_default_' + cell);
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attributes: { _ab_pack_default: cell } })
      });
    })();
  </script>
{%- endif -%}