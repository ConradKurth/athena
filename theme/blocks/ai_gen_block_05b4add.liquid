    {
      "type": "range",
      "id": "h1_size_mobile",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "H1 size (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "h1_size_desktop",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "H1 size (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "h2_size_mobile",
      "min": 18,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "H2 size (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "h2_size_desktop",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "H2 size (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "h3_size_mobile",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "H3 size (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "h3_size_desktop",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "H3 size (desktop)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#193445"
    },
    {
      "type": "range",
      "id": "text_size_mobile",
