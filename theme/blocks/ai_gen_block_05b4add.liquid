{% doc %}
  @prompt
    add a heading section with customization options, no need for subheading option just keep it a rich text section with only heading thats customizable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-richtext-block-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.alignment }};
  }

  .ai-richtext-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-richtext-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size_mobile }}px;
    line-height: {{ block.settings.line_height }};
  }

  .ai-richtext-content-{{ ai_gen_id }} h1,
  .ai-richtext-content-{{ ai_gen_id }} h2,
  .ai-richtext-content-{{ ai_gen_id }} h3,
  .ai-richtext-content-{{ ai_gen_id }} h4,
  .ai-richtext-content-{{ ai_gen_id }} h5,
  .ai-richtext-content-{{ ai_gen_id }} h6 {
    color: {{ block.settings.heading_color }};
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    {% if block.settings.text_transform == 'uppercase' %}
      text-transform: uppercase;
    {% elsif block.settings.text_transform == 'capitalize' %}
      text-transform: capitalize;
    {% endif %}
  }

  .ai-richtext-content-{{ ai_gen_id }} h1 {
    font-size: {{ block.settings.h1_size_mobile }}px;
  }

  .ai-richtext-content-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.h2_size_mobile }}px;
  }

  .ai-richtext-content-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.h3_size_mobile }}px;
  }

  .ai-richtext-content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-richtext-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-richtext-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-richtext-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-richtext-content-{{ ai_gen_id }} ul,
  .ai-richtext-content-{{ ai_gen_id }} ol {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
    padding-left: 20px;
  }

  .ai-richtext-content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  @media screen and (min-width: 750px) {
    .ai-richtext-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_desktop }}px;
    }

    .ai-richtext-content-{{ ai_gen_id }} h1 {
      font-size: {{ block.settings.h1_size_desktop }}px;
    }

    .ai-richtext-content-{{ ai_gen_id }} h2 {
      font-size: {{ block.settings.h2_size_desktop }}px;
    }

    .ai-richtext-content-{{ ai_gen_id }} h3 {
      font-size: {{ block.settings.h3_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-richtext-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-richtext-container-{{ ai_gen_id }}">
    {% if block.settings.content != blank %}
      <div class="ai-richtext-content-{{ ai_gen_id }}">
        {{ block.settings.content }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
