{% doc %}
  @prompt
    Create a section with two columns.
    The left container has an image with a button inside (bottom-right)
    The right container is a featured product, The featured product section needs to be much more compact, Add controls to change the size of the product image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 40px 20px;
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .ai-two-column-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: {{ block.settings.column_gap }}px;
      padding: 60px 40px;
    }
  }

  .ai-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
  }

  .ai-image-wrapper-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-image-button-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    right: 20px;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    z-index: 2;
  }

  .ai-image-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-featured-product-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-product-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.product_image_border_radius }}px;
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.product_image_aspect_ratio }}%;
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-product-vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.vendor_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
  }

  .ai-product-price-{{ ai_gen_id }} .ai-compare-price-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
  }

  .ai-product-price-{{ ai_gen_id }} .ai-sale-price-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-product-description-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-product-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.product_button_bg_color }};
    color: {{ block.settings.product_button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.product_button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    transition: all 0.3s ease;
    margin-top: 8px;
  }

  .ai-product-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.product_button_hover_bg_color }};
    color: {{ block.settings.product_button_hover_text_color }};
  }

  .ai-empty-state-{{ ai_gen_id }} {
    padding: 20px;
    text-align: center;
    color: #999;
    font-size: 14px;
    font-style: italic;
  }
{% endstyle %}

<div class="ai-two-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-container-{{ ai_gen_id }}">
    <div class="ai-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
    {% if block.settings.button_text != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-image-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>

  <div class="ai-featured-product-{{ ai_gen_id }}">
    {% if block.settings.featured_product %}
      {% assign product = block.settings.featured_product %}
      
      <div class="ai-product-image-{{ ai_gen_id }}">
        <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {% else %}
            <div class="ai-product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-product-info-{{ ai_gen_id }}">
        {% if block.settings.show_vendor and product.vendor != blank %}
          <p class="ai-product-vendor-{{ ai_gen_id }}">{{ product.vendor }}</p>
        {% endif %}

        <h3 class="ai-product-title-{{ ai_gen_id }}">
          <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
            {{ product.title }}
          </a>
        </h3>

        <div class="ai-product-price-{{ ai_gen_id }}">
          {% if product.compare_at_price > product.price %}
            <span class="ai-compare-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
            <span class="ai-sale-price-{{ ai_gen_id }}">{{ product.price | money }}</span>
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </div>

        {% if block.settings.show_description and product.description != blank %}
          <p class="ai-product-description-{{ ai_gen_id }}">
            {{ product.description | strip_html | truncate: 120 }}
          </p>
        {% endif %}

        {% if block.settings.show_product_button %}
          <a
            href="{{ product.url }}"
            class="ai-product-button-{{ ai_gen_id }}"
          >
            {{ block.settings.product_button_text }}
          </a>
        {% endif %}
      </div>
    {% else %}
      <div class="ai-empty-state-{{ ai_gen_id }}">
        Select a featured product to display
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Two column feature",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Container width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Column gap",
      "default": 60
    },
    {
      "type": "header",
      "content": "Left column - Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 14
    },
    {
      "type": "header",
      "content": "Image button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#003649"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background color",
      "default": "#005c7c"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Right column - Featured product"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Product"
    },
    {
      "type": "range",
      "id": "product_image_aspect_ratio",
      "min": 50,
      "max": 150,
      "step": 10,
      "unit": "%",
      "label": "Image aspect ratio",
      "default": 100
    },
    {
      "type": "range",
      "id": "product_image_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "range",
      "id": "product_title_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 22
    },
    {
      "type": "range",
      "id": "product_price_size",
      "min": 14,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Price size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Product colors"
    },
    {
      "type": "color",
      "id": "vendor_color",
      "label": "Vendor",
      "default": "#717171"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#193445"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "sale_price_color",
      "label": "Sale price",
      "default": "#cf4a4a"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description",
      "default": "#717171"
    },
    {
      "type": "header",
      "content": "Product button"
    },
    {
      "type": "checkbox",
      "id": "show_product_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "product_button_text",
      "label": "Button text",
      "default": "View product"
    },
    {
      "type": "color",
      "id": "product_button_bg_color",
      "label": "Background color",
      "default": "#003649"
    },
    {
      "type": "color",
      "id": "product_button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "product_button_hover_bg_color",
      "label": "Hover background color",
      "default": "#005c7c"
    },
    {
      "type": "color",
      "id": "product_button_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "product_button_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Two column feature"
    }
  ]
}
{% endschema %}
