</features-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturesBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.carousel = this.querySelector('.ai-features-banner__carousel-{{ ai_gen_id }}');
        this.track = this.querySelector('.ai-features-banner__carousel-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-features-banner__carousel-slide-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-features-banner__dots-{{ ai_gen_id }}');
        this.autoplayDelay = {{ block.settings.autoplay_delay | times: 1000 }};

        if (this.carousel && this.slides.length > 0) {
          this.createDots();
          this.updateDots();
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-features-banner__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            this.stopAutoplay();
            this.startAutoplay();
          });
          this.dotsContainer.appendChild(dot);
        });
        this.dots = this.querySelectorAll('.ai-features-banner__dot-{{ ai_gen_id }}');
      }

      updateDots() {
        if (!this.dots) return;
        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlidePosition();
        this.updateDots();
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplayDelay);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }

      nextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.slides.length;
        this.updateSlidePosition();
        this.updateDots();
      }

      updateSlidePosition() {
        const offset = -this.currentSlide * 100;
        this.track.style.transform = `translateX(${offset}%)`;
      }
    }

    customElements.define('features-banner-{{ ai_gen_id }}', FeaturesBanner{{ ai_gen_id }});
  })();
</script>

