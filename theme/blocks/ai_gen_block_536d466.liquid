{% doc %}
  @prompt
    Please create a horizontal  icon/ features banner.
    It should allow up to 5 feature columns on desktop.
    It should allow horitonzal auto-scrolling on mobile.
    The section should have an h2 heading first. 
    Then, Each feature should have:
    - An icon field (pick from Shopify icon sets or upload)
    - A text field with options to set paragraph/heading level and font size.
    - a sub-text field with options to set paragraph/heading level and font size.
    All text and icons should be center aligned., The mobile version should show one feature at a time, and automatically show the next one after a few seconds (add a setting to control how long they show for), rmove the liquid error, let me add upto 6 feature columns, keep each feature column - text and subtext centeralligned. also show the scroll dots so user know there are more benefits but the features should keep scrolling automatically, make the dots really small and circular, give options to select feature icon from shopify's exisiting icon set or to upload custom icon for each, show icon instead of the text of icon 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-banner-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-features-banner__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 30px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-features-banner__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-features-banner__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }

  .ai-features-banner__feature-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-features-banner__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-features-banner__icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-features-banner__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-features-banner__text-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    text-align: center;
  }

  .ai-features-banner__subtext-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.subtext_color }};
    font-size: {{ block.settings.subtext_size }}px;
    text-align: center;
  }

  .ai-features-banner__carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-features-banner__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 20px;
  }

  .ai-features-banner__dot-{{ ai_gen_id }} {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    transition: opacity 0.3s ease;
    cursor: pointer;
    padding: 0;
    border: none;
  }

  .ai-features-banner__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-features-banner__grid-{{ ai_gen_id }} {
      display: none;
    }

    .ai-features-banner__carousel-{{ ai_gen_id }} {
      position: relative;
      overflow: hidden;
      display: block;
    }

    .ai-features-banner__carousel-track-{{ ai_gen_id }} {
      display: flex;
      transition: transform 0.5s ease-in-out;
    }

    .ai-features-banner__carousel-slide-{{ ai_gen_id }} {
      min-width: 100%;
      flex-shrink: 0;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-features-banner__carousel-wrapper-{{ ai_gen_id }} {
      display: none;
    }

    .ai-features-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-features-banner__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_desktop }}px;
    }

    .ai-features-banner__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size_desktop }}px;
    }
  }
{% endstyle %}

<features-banner-{{ ai_gen_id }} class="ai-features-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-features-banner__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-features-banner__container-{{ ai_gen_id }}">
    <div class="ai-features-banner__grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
          assign feature_icon_type_key = 'feature_' | append: i | append: '_icon_type'
          assign feature_shopify_icon_key = 'feature_' | append: i | append: '_shopify_icon'
          assign feature_custom_icon_key = 'feature_' | append: i | append: '_custom_icon'
          assign feature_text_key = 'feature_' | append: i | append: '_text'
          assign feature_text_tag_key = 'feature_' | append: i | append: '_text_tag'
          assign feature_subtext_key = 'feature_' | append: i | append: '_subtext'
          assign feature_subtext_tag_key = 'feature_' | append: i | append: '_subtext_tag'

          assign feature_enabled = block.settings[feature_enabled_key]
          assign feature_icon_type = block.settings[feature_icon_type_key]
          assign feature_shopify_icon = block.settings[feature_shopify_icon_key]
          assign feature_custom_icon = block.settings[feature_custom_icon_key]
          assign feature_text = block.settings[feature_text_key]
          assign feature_text_tag = block.settings[feature_text_tag_key]
          assign feature_subtext = block.settings[feature_subtext_key]
          assign feature_subtext_tag = block.settings[feature_subtext_tag_key]
        %}

        {% if feature_enabled %}
          <div class="ai-features-banner__feature-{{ ai_gen_id }}">
            <div class="ai-features-banner__icon-{{ ai_gen_id }}">
              {% if feature_icon_type == 'custom' and feature_custom_icon != blank %}
                <img src="{{ feature_custom_icon | image_url: width: 200 }}" alt="{{ feature_text | escape }}" loading="lazy">
              {% elsif feature_icon_type == 'shopify' and feature_shopify_icon != 'none' %}
                {% case feature_shopify_icon %}
                  {% when 'checkmark' %}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                  {% when 'truck' %}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18 18.5a1.5 1.5 0 0 1-1.5-1.5a1.5 1.5 0 0 1 1.5-1.5a1.5 1.5 0 0 1 1.5 1.5a1.5 1.5 0 0 1-1.5 1.5m1.5-9l1.96 2.5H17V9.5m-11 9A1.5 1.5 0 0 1 4.5 17A1.5 1.5 0 0 1 6 15.5A1.5 1.5 0 0 1 7.5 17A1.5 1.5 0 0 1 6 18.5M20 8h-3V4H3c-1.11 0-2 .89-2 2v11h2a3 3 0 0 0 3 3a3 3 0 0 0 3-3h6a3 3 0 0 0 3 3a3 3 0 0 0 3-3h2v-5l-3-4z"/></svg>
