            </div>

            {% if feature_text != blank %}
              {% if feature_text_tag == 'h2' %}
                <h2 class="ai-features-banner__text-{{ ai_gen_id }}">{{ feature_text }}</h2>
              {% elsif feature_text_tag == 'h3' %}
                <h3 class="ai-features-banner__text-{{ ai_gen_id }}">{{ feature_text }}</h3>
              {% elsif feature_text_tag == 'h4' %}
                <h4 class="ai-features-banner__text-{{ ai_gen_id }}">{{ feature_text }}</h4>
              {% else %}
                <p class="ai-features-banner__text-{{ ai_gen_id }}">{{ feature_text }}</p>
              {% endif %}
            {% endif %}

            {% if feature_subtext != blank %}
              {% if feature_subtext_tag == 'h2' %}
                <h2 class="ai-features-banner__subtext-{{ ai_gen_id }}">{{ feature_subtext }}</h2>
              {% elsif feature_subtext_tag == 'h3' %}
                <h3 class="ai-features-banner__subtext-{{ ai_gen_id }}">{{ feature_subtext }}</h3>
              {% elsif feature_subtext_tag == 'h4' %}
                <h4 class="ai-features-banner__subtext-{{ ai_gen_id }}">{{ feature_subtext }}</h4>
              {% else %}
                <p class="ai-features-banner__subtext-{{ ai_gen_id }}">{{ feature_subtext }}</p>
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
