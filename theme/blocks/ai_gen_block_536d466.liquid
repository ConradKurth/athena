      <div class="ai-features-banner__carousel-{{ ai_gen_id }}">
        <div class="ai-features-banner__carousel-track-{{ ai_gen_id }}">
          {% for i in (1..6) %}
            {% liquid
              assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
              assign feature_icon_type_key = 'feature_' | append: i | append: '_icon_type'
              assign feature_shopify_icon_key = 'feature_' | append: i | append: '_shopify_icon'
              assign feature_custom_icon_key = 'feature_' | append: i | append: '_custom_icon'
              assign feature_text_key = 'feature_' | append: i | append: '_text'
