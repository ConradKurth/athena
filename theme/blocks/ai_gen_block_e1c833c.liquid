{% doc %}
  @prompt
    Create a footer with four columns:
    
    Column 1: A heading and a bit of text.
    
    Column 2: Space for a custom liquid (form embed)
    
    Column 3: Quick Links (Import footer links from Menus here)
    
    Column 4: Social
    Include a place to add an email address and icons linking to instagram and facebook.
    
    Make sure we can edit the background color of the section., Ensure the custom liquid field can actually embed from a snippet like this one:
    <div id="omnisend-embedded-v2-693bfc7a8e43194d754e72af"></div>, If no fields are filled in for column 2, please hide the column, compensating for space.
    
    Provide an option to organize the Menu in column 3 as two columns instead of one.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign show_column_2 = false %}
{% if block.settings.column_2_heading != blank or block.settings.column_2_html != blank %}
  {% assign show_column_2 = true %}
{% endif %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }

  .ai-footer-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media screen and (min-width: 750px) {
    .ai-footer-grid-{{ ai_gen_id }} {
      {% if show_column_2 %}
        grid-template-columns: repeat(2, 1fr);
      {% else %}
        grid-template-columns: repeat(3, 1fr);
      {% endif %}
      gap: 30px;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-footer-grid-{{ ai_gen_id }} {
      {% if show_column_2 %}
        grid-template-columns: repeat(4, 1fr);
      {% else %}
        grid-template-columns: repeat(3, 1fr);
      {% endif %}
      gap: 40px;
    }
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
    text-transform: {{ block.settings.heading_uppercase }};
    letter-spacing: 0.5px;
  }

  .ai-footer-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-text-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-footer-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-footer-links-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-links-{{ ai_gen_id }}.ai-footer-links-two-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 20px;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.text_size }}px;
    transition: color 0.3s ease;
    display: inline-block;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-social-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-email-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    word-break: break-word;
  }

  .ai-footer-email-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-footer-email-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-social-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .ai-footer-social-icon-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .ai-footer-social-icon-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
    transform: scale(1.1);
  }

  .ai-footer-social-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .ai-footer-html-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
  }
{% endstyle %}

<div class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-grid-{{ ai_gen_id }}">
      
      <div class="ai-footer-column-{{ ai_gen_id }}">
        {% if block.settings.column_1_heading != blank %}
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
        {% endif %}
        {% if block.settings.column_1_text != blank %}
          <div class="ai-footer-text-{{ ai_gen_id }}">
            {{ block.settings.column_1_text }}
          </div>
        {% endif %}
      </div>

      {% if show_column_2 %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          {% if block.settings.column_2_heading != blank %}
            <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
          {% endif %}
          {% if block.settings.column_2_html != blank %}
            <div class="ai-footer-html-{{ ai_gen_id }}">
              {{ block.settings.column_2_html }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <div class="ai-footer-column-{{ ai_gen_id }}">
        {% if block.settings.column_3_heading != blank %}
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_3_heading }}</h3>
        {% endif %}
        {% if block.settings.menu != blank %}
          <ul class="ai-footer-links-{{ ai_gen_id }} {% if block.settings.menu_two_columns %}ai-footer-links-two-columns-{{ ai_gen_id }}{% endif %}">
            {% for link in block.settings.menu.links %}
              <li>
                <a href="{{ link.url }}" class="ai-footer-link-{{ ai_gen_id }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        {% if block.settings.column_4_heading != blank %}
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.column_4_heading }}</h3>
        {% endif %}
        <div class="ai-footer-social-{{ ai_gen_id }}">
          {% if block.settings.email_address != blank %}
            <div class="ai-footer-email-{{ ai_gen_id }}">
              <a href="mailto:{{ block.settings.email_address }}" class="ai-footer-email-link-{{ ai_gen_id }}">
                {{ block.settings.email_address }}
              </a>
            </div>
          {% endif %}
          
          <div class="ai-footer-social-icons-{{ ai_gen_id }}">
            {% if block.settings.instagram_url != blank %}
              <a 
                href="{{ block.settings.instagram_url }}" 
                class="ai-footer-social-icon-{{ ai_gen_id }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
            {% endif %}
            
            {% if block.settings.facebook_url != blank %}
              <a 
                href="{{ block.settings.facebook_url }}" 
                class="ai-footer-social-icon-{{ ai_gen_id }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer columns",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#005c7c"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "select",
      "id": "heading_uppercase",
      "label": "Heading style",
      "options": [
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Heading",
      "default": "About us"
    },
    {
      "type": "richtext",
      "id": "column_1_text",
      "label": "Text",
      "default": "<p>Add your company description or mission statement here.</p>"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Heading",
      "default": "Newsletter"
    },
    {
      "type": "html",
      "id": "column_2_html",
      "label": "Form embed code",
      "info": "Paste your form embed code here (e.g., Omnisend, Klaviyo, Mailchimp). Leave both heading and code empty to hide this column."
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "Heading",
      "default": "Quick links"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "menu_two_columns",
      "label": "Display menu in two columns",
      "default": false
    },
    {
      "type": "header",
      "content": "Column 4"
    },
    {
      "type": "text",
      "id": "column_4_heading",
      "label": "Heading",
      "default": "Connect"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email address"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 24
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "Icon hover color",
      "default": "#005c7c"
    }
  ],
  "presets": [
    {
      "name": "Footer columns"
    }
  ]
}
{% endschema %}
