{% doc %}
  @prompt
    create a section similar to lookbook but give option to add text along with each image and number the tiles as 1,2,3,4 and so on, keep only two images in one row, add some design element that shows flow of steps from 1 to 2, 2 to 3, 3 to 4 and so on
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-numbered-lookbook-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-numbered-lookbook__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-numbered-lookbook__heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-numbered-lookbook__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    position: relative;
  }

  .ai-numbered-lookbook__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.tile_background }};
  }

  .ai-numbered-lookbook__item-{{ ai_gen_id }}:nth-child(odd):not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 100%;
    width: {{ block.settings.grid_gap }}px;
    height: 3px;
    background-color: {{ block.settings.arrow_color }};
    z-index: 1;
  }

  .ai-numbered-lookbook__item-{{ ai_gen_id }}:nth-child(odd):not(:last-child)::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(100% + {{ block.settings.grid_gap }}px - 10px);
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid {{ block.settings.arrow_color }};
    transform: translateY(-50%);
    z-index: 2;
  }

  .ai-numbered-lookbook__item-{{ ai_gen_id }}:nth-child(even):not(:last-child)::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 3px;
    height: {{ block.settings.grid_gap }}px;
    background-color: {{ block.settings.arrow_color }};
    transform: translateX(-50%);
    z-index: 1;
  }

  .ai-numbered-lookbook__item-{{ ai_gen_id }}:nth-child(even):not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(100% + {{ block.settings.grid_gap }}px - 10px);
    left: 50%;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 10px solid {{ block.settings.arrow_color }};
    transform: translateX(-50%);
    z-index: 2;
  }

  .ai-numbered-lookbook__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
  }

  .ai-numbered-lookbook__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-numbered-lookbook__item-{{ ai_gen_id }}:hover .ai-numbered-lookbook__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-numbered-lookbook__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-numbered-lookbook__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-numbered-lookbook__number-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.number_position_top }}px;
    left: {{ block.settings.number_position_left }}px;
    width: {{ block.settings.number_size }}px;
    height: {{ block.settings.number_size }}px;
    background-color: {{ block.settings.number_background }};
    color: {{ block.settings.number_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: {{ block.settings.number_font_size }}px;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-numbered-lookbook__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-numbered-lookbook__title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
  }

  .ai-numbered-lookbook__text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-numbered-lookbook-{{ ai_gen_id }} {
      padding: 30px 15px;
    }

    .ai-numbered-lookbook__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-numbered-lookbook__item-{{ ai_gen_id }}:nth-child(odd):not(:last-child)::after,
    .ai-numbered-lookbook__item-{{ ai_gen_id }}:nth-child(odd):not(:last-child)::before {
      display: none;
    }

    .ai-numbered-lookbook__item-{{ ai_gen_id }}:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 100%;
      left: 50%;
      width: 3px;
      height: calc({{ block.settings.grid_gap | times: 0.7 }}px);
      background-color: {{ block.settings.arrow_color }};
      transform: translateX(-50%);
      z-index: 1;
      display: block;
    }

    .ai-numbered-lookbook__item-{{ ai_gen_id }}:not(:last-child)::before {
      content: '';
      position: absolute;
      top: calc(100% + {{ block.settings.grid_gap | times: 0.7 }}px - 10px);
      left: 50%;
      width: 0;
      height: 0;
      border-left: 6px solid transparent;
      border-right: 6px solid transparent;
      border-top: 10px solid {{ block.settings.arrow_color }};
      transform: translateX(-50%);
      z-index: 2;
      display: block;
    }

    .ai-numbered-lookbook__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
      margin-bottom: 25px;
    }

    .ai-numbered-lookbook__number-{{ ai_gen_id }} {
      width: calc({{ block.settings.number_size }}px * 0.8);
      height: calc({{ block.settings.number_size }}px * 0.8);
      font-size: calc({{ block.settings.number_font_size }}px * 0.8);
    }

    .ai-numbered-lookbook__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.9);
    }

    .ai-numbered-lookbook__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-numbered-lookbook-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-numbered-lookbook__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-numbered-lookbook__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-numbered-lookbook__grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign title_key = 'title_' | append: i
          assign text_key = 'text_' | append: i
          assign link_key = 'link_' | append: i
          
          assign item_image = block.settings[image_key]
          assign item_title = block.settings[title_key]
          assign item_text = block.settings[text_key]
          assign item_link = block.settings[link_key]
        %}

        {% if item_image != blank or item_title != blank or item_text != blank %}
          <div class="ai-numbered-lookbook__item-{{ ai_gen_id }}">
            {% if item_link != blank %}
              <a href="{{ item_link }}" class="ai-numbered-lookbook__link-{{ ai_gen_id }}">
            {% endif %}

            <div class="ai-numbered-lookbook__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-numbered-lookbook__number-{{ ai_gen_id }}">{{ i }}</div>
              
              {% if item_image %}
                <img
                  src="{{ item_image | image_url: width: 800 }}"
                  alt="{{ item_image.alt | escape }}"
                  loading="lazy"
                  width="{{ item_image.width }}"
                  height="{{ item_image.height }}"
                  class="ai-numbered-lookbook__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-numbered-lookbook__placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if item_title != blank or item_text != blank %}
              <div class="ai-numbered-lookbook__content-{{ ai_gen_id }}">
                {% if item_title != blank %}
                  <h3 class="ai-numbered-lookbook__title-{{ ai_gen_id }}">{{ item_title }}</h3>
                {% endif %}
                
                {% if item_text != blank %}
                  <div class="ai-numbered-lookbook__text-{{ ai_gen_id }}">{{ item_text }}</div>
                {% endif %}
              </div>
            {% endif %}

            {% if item_link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

