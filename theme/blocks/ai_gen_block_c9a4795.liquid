{% doc %}
  @prompt
    A two-column layout.
    
    Acceptance criteria:
    The whole section has a centered H2.
    Each column has 3 rows.
    Each Column has a centered H3 in row 1.
    Each column has an image with an adjustable height and width in row 2.
    Each column has a paragraph text field in row 3.
    The columns appear side-by-side on desktop.
    The columns have a separator line between them on desktop.
    The background color of each column can be adjusted separately.
    
    For mobile, provide two options:
    - Stack on Mobile (Columns appear one under the other)
    - Carousel style (with dots and arrows for navigation) with automatic timed cycle (timing adjustable), Provide formatting options for the paragraph text (e.g. bold, italic, and bullets), Add settings to choose left or center alignment for the paragraph text fields, Ensure bullets are visible if selected in the paragraph formatting options, Ensure responsiveness in the mobile layout (automatic image resize and column width resize).
    Remove the navigation arrow background and make the arrows a dark color, Use the same auto-adjusted column width from the stacked layout on the carousel layout as well., The column width (image width and text container width) is correct on the stacked mobile setting, but it doesn't fit on screen in the carousel view. Redo the carousel option to be responsive., Add a column width setting for the carousel view that controls heading container width, image width, and text box width.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-layout-{{ ai_gen_id }} {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-two-column-layout__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 40px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-two-column-layout__container-{{ ai_gen_id }} {
    display: flex;
    gap: 0;
    position: relative;
  }

  .ai-two-column-layout__column-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 30px;
  }

  .ai-two-column-layout__column-1-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_1_bg_color }};
  }

  .ai-two-column-layout__column-2-{{ ai_gen_id }} {
    background-color: {{ block.settings.column_2_bg_color }};
  }

  .ai-two-column-layout__separator-{{ ai_gen_id }} {
    width: 1px;
    background-color: {{ block.settings.separator_color }};
    flex-shrink: 0;
  }

  .ai-two-column-layout__column-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 20px;
    color: {{ block.settings.column_heading_color }};
    font-size: {{ block.settings.column_heading_size }}px;
  }

  .ai-two-column-layout__image-wrapper-{{ ai_gen_id }} {
    margin: 20px 0;
    text-align: center;
  }

  .ai-two-column-layout__image-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    height: {{ block.settings.image_height }}px;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-column-layout__image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    height: {{ block.settings.image_height }}px;
    margin: 0 auto;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-column-layout__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} {
    margin: 20px 0 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-two-column-layout__text-1-{{ ai_gen_id }} {
    text-align: {{ block.settings.column_1_text_alignment }};
  }

  .ai-two-column-layout__text-2-{{ ai_gen_id }} {
    text-align: {{ block.settings.column_2_text_alignment }};
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} ul,
  .ai-two-column-layout__text-{{ ai_gen_id }} ol {
    margin: 0 0 1em;
    padding-left: 1.5em;
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} ul:last-child,
  .ai-two-column-layout__text-{{ ai_gen_id }} ol:last-child {
    margin-bottom: 0;
  }

  .ai-two-column-layout__text-1-{{ ai_gen_id }} ul,
  .ai-two-column-layout__text-1-{{ ai_gen_id }} ol {
    {% if block.settings.column_1_text_alignment == 'center' %}
      list-style-position: inside;
      padding-left: 0;
    {% else %}
      list-style-position: outside;
      text-align: left;
    {% endif %}
  }

  .ai-two-column-layout__text-2-{{ ai_gen_id }} ul,
  .ai-two-column-layout__text-2-{{ ai_gen_id }} ol {
    {% if block.settings.column_2_text_alignment == 'center' %}
      list-style-position: inside;
      padding-left: 0;
    {% else %}
      list-style-position: outside;
      text-align: left;
    {% endif %}
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} ul {
    list-style-type: disc;
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} ol {
    list-style-type: decimal;
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} li {
    margin-bottom: 0.5em;
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} li:last-child {
    margin-bottom: 0;
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} strong {
    font-weight: 600;
  }

  .ai-two-column-layout__text-{{ ai_gen_id }} em {
    font-style: italic;
  }

  .ai-two-column-layout__carousel-{{ ai_gen_id }} {
    display: none;
    position: relative;
  }

  .ai-two-column-layout__carousel-track-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-two-column-layout__carousel-slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-two-column-layout__carousel-slide-{{ ai_gen_id }} {
    min-width: 100%;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .ai-two-column-layout__carousel-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 20px;
  }

  .ai-two-column-layout__carousel-arrow-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.carousel_arrow_color }};
    border: none;
    width: 40px;
    height: 40px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
    padding: 0;
  }

  .ai-two-column-layout__carousel-arrow-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-two-column-layout__carousel-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-two-column-layout__carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.carousel_dot_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-two-column-layout__carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-layout-{{ ai_gen_id }} {
      padding: 30px 15px;
    }

    .ai-two-column-layout__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: 30px;
    }

    .ai-two-column-layout__column-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_heading_size | times: 0.8 }}px;
    }

    .ai-two-column-layout__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-two-column-layout__image-{{ ai_gen_id }} {
      width: 100%;
      height: auto;
      max-height: 300px;
    }

    .ai-two-column-layout__image-placeholder-{{ ai_gen_id }} {
      width: 100%;
      height: auto;
      min-height: 200px;
      max-height: 300px;
    }

    .ai-two-column-layout__column-{{ ai_gen_id }} {
      padding: 20px;
      width: 100%;
      box-sizing: border-box;
    }

    {% if block.settings.mobile_layout == 'stack' %}
      .ai-two-column-layout__container-{{ ai_gen_id }} {
        flex-direction: column;
      }

      .ai-two-column-layout__separator-{{ ai_gen_id }} {
        display: none;
      }
    {% elsif block.settings.mobile_layout == 'carousel' %}
      .ai-two-column-layout__container-{{ ai_gen_id }} {
        display: none;
      }

      .ai-two-column-layout__carousel-{{ ai_gen_id }} {
        display: block;
      }

      .ai-two-column-layout__carousel-slide-{{ ai_gen_id }} .ai-two-column-layout__column-{{ ai_gen_id }} {
        max-width: {{ block.settings.carousel_column_width }}%;
        margin: 0 auto;
      }

      .ai-two-column-layout__carousel-slide-{{ ai_gen_id }} .ai-two-column-layout__column-heading-{{ ai_gen_id }} {
        max-width: 100%;
      }

      .ai-two-column-layout__carousel-slide-{{ ai_gen_id }} .ai-two-column-layout__image-wrapper-{{ ai_gen_id }} {
        max-width: 100%;
      }

      .ai-two-column-layout__carousel-slide-{{ ai_gen_id }} .ai-two-column-layout__text-{{ ai_gen_id }} {
        max-width: 100%;
      }
    {% endif %}
  }
{% endstyle %}

<two-column-layout-{{ ai_gen_id }} class="ai-two-column-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_heading != blank %}
    <h2 class="ai-two-column-layout__heading-{{ ai_gen_id }}">{{ block.settings.main_heading }}</h2>
  {% endif %}

  <div class="ai-two-column-layout__container-{{ ai_gen_id }}">
    <div class="ai-two-column-layout__column-{{ ai_gen_id }} ai-two-column-layout__column-1-{{ ai_gen_id }}">
      {% if block.settings.column_1_heading != blank %}
        <h3 class="ai-two-column-layout__column-heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
      {% endif %}

      <div class="ai-two-column-layout__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.column_1_image %}
          <img
            src="{{ block.settings.column_1_image | image_url: width: 1000 }}"
            alt="{{ block.settings.column_1_image.alt | escape }}"
            class="ai-two-column-layout__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.column_1_image.width }}"
            height="{{ block.settings.column_1_image.height }}"
          >
        {% else %}
          <div class="ai-two-column-layout__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.column_1_text != blank %}
        <div class="ai-two-column-layout__text-{{ ai_gen_id }} ai-two-column-layout__text-1-{{ ai_gen_id }}">{{ block.settings.column_1_text }}</div>
      {% endif %}
    </div>

    <div class="ai-two-column-layout__separator-{{ ai_gen_id }}"></div>

    <div class="ai-two-column-layout__column-{{ ai_gen_id }} ai-two-column-layout__column-2-{{ ai_gen_id }}">
      {% if block.settings.column_2_heading != blank %}
        <h3 class="ai-two-column-layout__column-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
      {% endif %}

      <div class="ai-two-column-layout__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.column_2_image %}
          <img
            src="{{ block.settings.column_2_image | image_url: width: 1000 }}"
            alt="{{ block.settings.column_2_image.alt | escape }}"
            class="ai-two-column-layout__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.column_2_image.width }}"
            height="{{ block.settings.column_2_image.height }}"
          >
        {% else %}
          <div class="ai-two-column-layout__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.column_2_text != blank %}
        <div class="ai-two-column-layout__text-{{ ai_gen_id }} ai-two-column-layout__text-2-{{ ai_gen_id }}">{{ block.settings.column_2_text }}</div>
      {% endif %}
    </div>
  </div>

  {% if block.settings.mobile_layout == 'carousel' %}
    <div class="ai-two-column-layout__carousel-{{ ai_gen_id }}">
      <div class="ai-two-column-layout__carousel-track-{{ ai_gen_id }}">
        <div class="ai-two-column-layout__carousel-slides-{{ ai_gen_id }}">
          <div class="ai-two-column-layout__carousel-slide-{{ ai_gen_id }}">
            <div class="ai-two-column-layout__column-{{ ai_gen_id }} ai-two-column-layout__column-1-{{ ai_gen_id }}">
              {% if block.settings.column_1_heading != blank %}
                <h3 class="ai-two-column-layout__column-heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
              {% endif %}

              <div class="ai-two-column-layout__image-wrapper-{{ ai_gen_id }}">
                {% if block.settings.column_1_image %}
                  <img
                    src="{{ block.settings.column_1_image | image_url: width: 1000 }}"
                    alt="{{ block.settings.column_1_image.alt | escape }}"
                    class="ai-two-column-layout__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ block.settings.column_1_image.width }}"
                    height="{{ block.settings.column_1_image.height }}"
                  >
                {% else %}
                  <div class="ai-two-column-layout__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              {% if block.settings.column_1_text != blank %}
                <div class="ai-two-column-layout__text-{{ ai_gen_id }} ai-two-column-layout__text-1-{{ ai_gen_id }}">{{ block.settings.column_1_text }}</div>
              {% endif %}
            </div>
          </div>

          <div class="ai-two-column-layout__carousel-slide-{{ ai_gen_id }}">
            <div class="ai-two-column-layout__column-{{ ai_gen_id }} ai-two-column-layout__column-2-{{ ai_gen_id }}">
              {% if block.settings.column_2_heading != blank %}
                <h3 class="ai-two-column-layout__column-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
              {% endif %}

              <div class="ai-two-column-layout__image-wrapper-{{ ai_gen_id }}">
                {% if block.settings.column_2_image %}
                  <img
                    src="{{ block.settings.column_2_image | image_url: width: 1000 }}"
                    alt="{{ block.settings.column_2_image.alt | escape }}"
                    class="ai-two-column-layout__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ block.settings.column_2_image.width }}"
                    height="{{ block.settings.column_2_image.height }}"
                  >
                {% else %}
                  <div class="ai-two-column-layout__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              {% if block.settings.column_2_text != blank %}
                <div class="ai-two-column-layout__text-{{ ai_gen_id }} ai-two-column-layout__text-2-{{ ai_gen_id }}">{{ block.settings.column_2_text }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="ai-two-column-layout__carousel-nav-{{ ai_gen_id }}">
        <button class="ai-two-column-layout__carousel-arrow-{{ ai_gen_id }} ai-two-column-layout__carousel-prev-{{ ai_gen_id }}" aria-label="Previous slide">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-two-column-layout__carousel-dots-{{ ai_gen_id }}">
          <button class="ai-two-column-layout__carousel-dot-{{ ai_gen_id }} active" data-slide="0" aria-label="Go to slide 1"></button>
          <button class="ai-two-column-layout__carousel-dot-{{ ai_gen_id }}" data-slide="1" aria-label="Go to slide 2"></button>
        </div>

        <button class="ai-two-column-layout__carousel-arrow-{{ ai_gen_id }} ai-two-column-layout__carousel-next-{{ ai_gen_id }}" aria-label="Next slide">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  {% endif %}
</two-column-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.carousel = this.querySelector('.ai-two-column-layout__carousel-{{ ai_gen_id }}');
        if (!this.carousel) return;

        this.slidesContainer = this.querySelector('.ai-two-column-layout__carousel-slides-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-two-column-layout__carousel-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-two-column-layout__carousel-next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-two-column-layout__carousel-dot-{{ ai_gen_id }}');
        this.totalSlides = 2;
        this.autoplayDuration = {{ block.settings.carousel_autoplay_duration | times: 1000 }};

        this.setupEventListeners();
        this.startAutoplay();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => {
          this.goToSlide(this.currentSlide - 1);
          this.resetAutoplay();
        });

        this.nextButton.addEventListener('click', () => {
          this.goToSlide(this.currentSlide + 1);
          this.resetAutoplay();
        });

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            this.resetAutoplay();
          });
        });
      }

      goToSlide(index) {
        if (index < 0) {
          this.currentSlide = this.totalSlides - 1;
        } else if (index >= this.totalSlides) {
          this.currentSlide = 0;
        } else {
          this.currentSlide = index;
        }

        this.slidesContainer.style.transform = `translateX(-${this.currentSlide * 100}%)`;

        this.dots.forEach((dot, i) => {
          if (i === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        if (this.autoplayDuration > 0) {
          this.autoplayInterval = setInterval(() => {
            this.goToSlide(this.currentSlide + 1);
          }, this.autoplayDuration);
        }
      }

      resetAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('two-column-layout-{{ ai_gen_id }}', TwoColumnLayout{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Two column layout",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Main heading"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Heading",
      "default": "Our Features"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#193445"
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Heading",
      "default": "Feature One"
    },
    {
      "type": "image_picker",
      "id": "column_1_image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "column_1_text",
      "label": "Text",
      "default": "<p>Describe your first feature here. Add details that make it compelling and informative.</p>"
    },
    {
      "type": "select",
      "id": "column_1_text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "column_1_bg_color",
      "label": "Background color",
      "default": "#f9f9f9"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Heading",
      "default": "Feature Two"
    },
    {
      "type": "image_picker",
      "id": "column_2_image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "column_2_text",
      "label": "Text",
      "default": "<p>Describe your second feature here. Add details that make it compelling and informative.</p>"
    },
    {
      "type": "select",
      "id": "column_2_text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "column_2_bg_color",
      "label": "Background color",
      "default": "#ffffff"
