{% doc %}
  @prompt
    Create a horizontally auto-scrolling marquee section with the heading "Works with the briefs you already trust". Below it, a continuously scrolling row of brand names in elegant text pills: Depend®, Always Discreet®, TENA®, Prevail®, Tranquility®, Because®, Assurance®, Member's Mark®. Each pill: white background, 1px 
    #193445 border, rounded corners (24px), padding 10px 22px, navy 
    #193445 text, 16px, spaced 16px apart. Background color 
    #fbf0ef. Pause scrolling on hover. Below the scroller, small centered gray text (12px, 
    #717171): "All trademarks are property of their respective owners. UraGuard® is not affiliated with or endorsed by these brands." Mobile-friendly, seamless infinite loop, scroll speed slow and smooth.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-marquee-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-brand-marquee-container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-brand-marquee-heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size_mobile }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 600;
  }

  @media screen and (min-width: 750px) {
    .ai-brand-marquee-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-brand-marquee-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
    width: 100%;
    margin-bottom: {{ block.settings.disclaimer_spacing }}px;
  }

  .ai-brand-marquee-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.pill_spacing }}px;
    animation: ai-brand-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-brand-marquee-wrapper-{{ ai_gen_id }}:hover .ai-brand-marquee-track-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-brand-marquee-pill-{{ ai_gen_id }} {
    flex-shrink: 0;
    background-color: {{ block.settings.pill_background }};
    border: {{ block.settings.pill_border_width }}px solid {{ block.settings.pill_border_color }};
    border-radius: {{ block.settings.pill_border_radius }}px;
    padding: {{ block.settings.pill_padding_vertical }}px {{ block.settings.pill_padding_horizontal }}px;
    color: {{ block.settings.pill_text_color }};
    font-size: {{ block.settings.pill_font_size }}px;
    white-space: nowrap;
    font-weight: 400;
  }

  @keyframes ai-brand-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-brand-marquee-disclaimer-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.disclaimer_font_size }}px;
    color: {{ block.settings.disclaimer_color }};
    line-height: 1.5;
    max-width: 800px;
    margin: 0 auto;
  }
{% endstyle %}

<brand-marquee-{{ ai_gen_id }} class="ai-brand-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-marquee-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-brand-marquee-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-brand-marquee-wrapper-{{ ai_gen_id }}">
      <div class="ai-brand-marquee-track-{{ ai_gen_id }}">
        {% for i in (1..2) %}
          {% if block.settings.brand_1 != blank %}
            <div class="ai-brand-marquee-pill-{{ ai_gen_id }}">{{ block.settings.brand_1 }}</div>
          {% endif %}
          {% if block.settings.brand_2 != blank %}
            <div class="ai-brand-marquee-pill-{{ ai_gen_id }}">{{ block.settings.brand_2 }}</div>
          {% endif %}
          {% if block.settings.brand_3 != blank %}
            <div class="ai-brand-marquee-pill-{{ ai_gen_id }}">{{ block.settings.brand_3 }}</div>
          {% endif %}
          {% if block.settings.brand_4 != blank %}
            <div class="ai-brand-marquee-pill-{{ ai_gen_id }}">{{ block.settings.brand_4 }}</div>
          {% endif %}
          {% if block.settings.brand_5 != blank %}
            <div class="ai-brand-marquee-pill-{{ ai_gen_id }}">{{ block.settings.brand_5 }}</div>
          {% endif %}
          {% if block.settings.brand_6 != blank %}
            <div class="ai-brand-marquee-pill-{{ ai_gen_id }}">{{ block.settings.brand_6 }}</div>
          {% endif %}
          {% if block.settings.brand_7 != blank %}
            <div class="ai-brand-marquee-pill-{{ ai_gen_id }}">{{ block.settings.brand_7 }}</div>
          {% endif %}
          {% if block.settings.brand_8 != blank %}
            <div class="ai-brand-marquee-pill-{{ ai_gen_id }}">{{ block.settings.brand_8 }}</div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if block.settings.disclaimer != blank %}
      <div class="ai-brand-marquee-disclaimer-{{ ai_gen_id }}">{{ block.settings.disclaimer }}</div>
    {% endif %}
  </div>
</brand-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    class BrandMarquee{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-brand-marquee-track-{{ ai_gen_id }}');
        this.adjustScrollSpeed();
      }

      adjustScrollSpeed() {
        if (!this.track) return;
        
        const trackWidth = this.track.scrollWidth / 2;
        const speed = {{ block.settings.scroll_speed }};
        const duration = (trackWidth / 100) * speed;
        
        this.track.style.animationDuration = duration + 's';
      }
    }

    customElements.define('brand-marquee-{{ ai_gen_id }}', BrandMarquee{{ ai_gen_id }});
  })();
</script>

