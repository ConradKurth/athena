{% doc %}
  @prompt
    Create a floating featured product block that sticks to the right-hand side of the screen.
    Add controls to have it appear and disappear based on scroll depth.
    Add controls to hide it on mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-floating-product-{{ ai_gen_id }} {
    position: fixed;
    right: {{ block.settings.offset_right }}px;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.block_width }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    padding: {{ block.settings.padding }}px;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-floating-product-{{ ai_gen_id }}.visible {
    opacity: 1;
    visibility: visible;
  }

  .ai-floating-product-close-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .ai-floating-product-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-floating-product-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 15px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-floating-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-floating-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-floating-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-floating-product-content-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-floating-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .ai-floating-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin-bottom: 15px;
    font-weight: 500;
  }

  .ai-floating-product-button-{{ ai_gen_id }} {
    display: inline-block;
    width: 100%;
    padding: 12px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-align: center;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-floating-product-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_background_hover }};
  }

  {% if block.settings.hide_on_mobile %}
    @media screen and (max-width: 749px) {
      .ai-floating-product-{{ ai_gen_id }} {
        display: none;
      }
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-floating-product-{{ ai_gen_id }} {
      width: {{ block.settings.block_width | times: 0.8 }}px;
      right: {{ block.settings.offset_right | times: 0.5 }}px;
      padding: {{ block.settings.padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<floating-product-{{ ai_gen_id }}
  class="ai-floating-product-{{ ai_gen_id }}"
  data-scroll-start="{{ block.settings.scroll_start }}"
  data-scroll-end="{{ block.settings.scroll_end }}"
  {{ block.shopify_attributes }}
>
  <button
    class="ai-floating-product-close-{{ ai_gen_id }}"
    aria-label="Close"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <div class="ai-floating-product-image-{{ ai_gen_id }}">
    {% if block.settings.featured_product and block.settings.featured_product.featured_image %}
      <img
        src="{{ block.settings.featured_product.featured_image | image_url: width: 400 }}"
        alt="{{ block.settings.featured_product.featured_image.alt | escape }}"
        loading="lazy"
        width="400"
        height="400"
      >
    {% else %}
      <div class="ai-floating-product-image-placeholder-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-floating-product-content-{{ ai_gen_id }}">
    {% if block.settings.featured_product %}
      <h3 class="ai-floating-product-title-{{ ai_gen_id }}">
        {{ block.settings.featured_product.title }}
      </h3>
      <div class="ai-floating-product-price-{{ ai_gen_id }}">
        {{ block.settings.featured_product.price | money }}
      </div>
      <a
        href="{{ block.settings.featured_product.url }}"
        class="ai-floating-product-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% else %}
      <h3 class="ai-floating-product-title-{{ ai_gen_id }}">
        Featured Product
      </h3>
      <div class="ai-floating-product-price-{{ ai_gen_id }}">
        $0.00
      </div>
      <button class="ai-floating-product-button-{{ ai_gen_id }}" disabled>
        {{ block.settings.button_text }}
      </button>
    {% endif %}
  </div>
</floating-product-{{ ai_gen_id }}>

<script>
  (function() {
    class FloatingProduct{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollStart = parseInt(this.dataset.scrollStart) || 0;
        this.scrollEnd = parseInt(this.dataset.scrollEnd) || 100;
        this.isClosed = false;
      }

      connectedCallback() {
        this.closeButton = this.querySelector('.ai-floating-product-close-{{ ai_gen_id }}');
        this.setupEventListeners();
        this.handleScroll();
      }

      setupEventListeners() {
        window.addEventListener('scroll', this.handleScroll.bind(this));
        
        if (this.closeButton) {
          this.closeButton.addEventListener('click', () => {
            this.isClosed = true;
            this.classList.remove('visible');
          });
        }
      }

      handleScroll() {
        if (this.isClosed) return;

        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrollPercent = (scrollTop / docHeight) * 100;

        if (scrollPercent >= this.scrollStart && scrollPercent <= this.scrollEnd) {
          this.classList.add('visible');
        } else {
          this.classList.remove('visible');
        }
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.handleScroll.bind(this));
      }
    }

    customElements.define('floating-product-{{ ai_gen_id }}', FloatingProduct{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Floating featured product",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "Scroll behavior"
    },
    {
      "type": "range",
      "id": "scroll_start",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Show at scroll depth",
      "default": 10
    },
    {
      "type": "range",
      "id": "scroll_end",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Hide at scroll depth",
      "default": 100
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "block_width",
      "min": 200,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Block width",
      "default": 280
    },
    {
      "type": "range",
      "id": "offset_right",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Distance from right edge",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 10
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#193445"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#003649"
    },
    {
      "type": "color",
      "id": "button_background_hover",
      "label": "Button hover background",
      "default": "#005c7c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Price size",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_text_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Floating featured product"
    }
  ]
}
{% endschema %}
