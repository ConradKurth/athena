{% doc %}
  @prompt
    create a scrolling text section where i can add multiple text that scroll next to each other, give me options for rich text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scrolling-text-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    position: relative;
  }

  .ai-scrolling-text-track-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-scrolling-text-{{ ai_gen_id }}:hover .ai-scrolling-text-track-{{ ai_gen_id }} {
    {% if block.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  .ai-scrolling-text-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.text_spacing }}px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-scrolling-text-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.font_weight }};
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
  }

  .ai-scrolling-text-content-{{ ai_gen_id }} p {
    margin: 0;
    display: inline;
  }

  .ai-scrolling-text-content-{{ ai_gen_id }} strong {
    font-weight: 700;
  }

  .ai-scrolling-text-content-{{ ai_gen_id }} em {
    font-style: italic;
  }

  .ai-scrolling-text-content-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: underline;
  }

  .ai-scrolling-text-separator-{{ ai_gen_id }} {
    width: {{ block.settings.separator_size }}px;
    height: {{ block.settings.separator_size }}px;
    background-color: {{ block.settings.separator_color }};
    border-radius: 50%;
    flex-shrink: 0;
  }

  @keyframes ai-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-scrolling-text-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-scrolling-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-scrolling-text-track-{{ ai_gen_id }}">
    {% liquid
      assign text_items = ''
      for i in (1..10)
        assign text_key = 'text_' | append: i
        assign text_value = block.settings[text_key]
        if text_value != blank
          assign text_items = text_items | append: text_value | append: '||'
        endif
      endfor
      assign text_array = text_items | split: '||'
    %}

    {% if text_array.size > 0 %}
      {% for i in (1..2) %}
        {% for text in text_array %}
          {% if text != blank %}
            <div class="ai-scrolling-text-item-{{ ai_gen_id }}">
              <div class="ai-scrolling-text-content-{{ ai_gen_id }}">{{ text }}</div>
              {% if block.settings.show_separator %}
                <span class="ai-scrolling-text-separator-{{ ai_gen_id }}"></span>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% else %}
      {% for i in (1..2) %}
        <div class="ai-scrolling-text-item-{{ ai_gen_id }}">
          <div class="ai-scrolling-text-content-{{ ai_gen_id }}"><p>Add your scrolling text here</p></div>
          {% if block.settings.show_separator %}
            <span class="ai-scrolling-text-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        </div>
        <div class="ai-scrolling-text-item-{{ ai_gen_id }}">
          <div class="ai-scrolling-text-content-{{ ai_gen_id }}"><p>Multiple text items scroll seamlessly</p></div>
          {% if block.settings.show_separator %}
            <span class="ai-scrolling-text-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        </div>
        <div class="ai-scrolling-text-item-{{ ai_gen_id }}">
          <div class="ai-scrolling-text-content-{{ ai_gen_id }}"><p>Customize in the theme editor</p></div>
          {% if block.settings.show_separator %}
            <span class="ai-scrolling-text-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling text",
  "settings": [
    {
      "type": "header",
      "content": "Text items"
    },
    {
      "type": "richtext",
      "id": "text_1",
      "label": "Text 1",
      "default": "<p>Free shipping on orders over $50</p>"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Text 2",
      "default": "<p>Shop the latest collection</p>"
    },
    {
      "type": "richtext",
      "id": "text_3",
      "label": "Text 3",
      "default": "<p>Limited time offer</p>"
    },
    {
      "type": "richtext",
      "id": "text_4",
      "label": "Text 4"
    },
    {
      "type": "richtext",
      "id": "text_5",
      "label": "Text 5"
    },
    {
      "type": "richtext",
      "id": "text_6",
      "label": "Text 6"
    },
    {
      "type": "richtext",
      "id": "text_7",
      "label": "Text 7"
    },
    {
      "type": "richtext",
      "id": "text_8",
      "label": "Text 8"
    },
    {
      "type": "richtext",
      "id": "text_9",
      "label": "Text 9"
    },
    {
      "type": "richtext",
      "id": "text_10",
      "label": "Text 10"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 18
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "label": "Letter spacing",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator",
      "default": true
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "separator_size",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "Separator size",
      "default": 6
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 30
    },
    {
      "type": "range",
      "id": "text_spacing",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Text spacing",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Scrolling text"
    }
  ]
}
{% endschema %}
