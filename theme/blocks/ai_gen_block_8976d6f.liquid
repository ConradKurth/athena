    },
    {
      "type": "color",
      "id": "product_text_color",
      "label": "Text color",
      "default": "#193445"
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Price color",
      "default": "#151515"
    },
    {
      "type": "text",
      "id": "product_button_text",
      "label": "Button text",
      "default": "View Product"
    },
    {
      "type": "color",
      "id": "product_button_background_color",
      "label": "Button background",
      "default": "#003649"
    },
    {
      "type": "color",
      "id": "product_button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "product_button_hover_background_color",
      "label": "Button hover background",
      "default": "#005c7c"
    },
    {
      "type": "color",
      "id": "product_button_hover_text_color",
      "label": "Button hover text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Featured product split"
    }
  ]
}
{% endschema %}
