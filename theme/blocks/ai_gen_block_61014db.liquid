{% doc %}
  @prompt
    create a section similar to lookbook but give option to add text along with each image keep only two images in one row, add some design element that shows flow of steps from 1 to 2, 2 to 3, 3 to 4 and so on, remove the arroww in the middle of two boxes, remove the line too betwwen box 1 and 2, remove the numbering on the boxes, keep the tile size same for all and give option to keep it fixed 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-step-guide-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-step-guide-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-step-guide-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-step-guide-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
  }

  .ai-step-guide-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-step-guide-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
  }

  @media screen and (min-width: 750px) {
    .ai-step-guide-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 80px 40px;
    }
  }

  .ai-step-guide-item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-step-guide-item-{{ ai_gen_id }}:nth-child(even) {
    grid-column: 2;
  }

  @media screen and (max-width: 749px) {
    .ai-step-guide-item-{{ ai_gen_id }}:nth-child(even) {
      grid-column: 1;
    }
  }

  .ai-step-guide-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    {% if block.settings.fixed_image_height %}
      height: {{ block.settings.image_height }}px;
    {% endif %}
  }

  .ai-step-guide-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    {% if block.settings.fixed_image_height %}
      height: 100%;
      object-fit: cover;
    {% else %}
      height: auto;
    {% endif %}
    display: block;
  }

  .ai-step-guide-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.fixed_image_height %}
      height: 100%;
    {% else %}
      aspect-ratio: 4 / 3;
    {% endif %}
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-step-guide-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-step-guide-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-step-guide-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    color: {{ block.settings.step_title_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-step-guide-step-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_text_size }}px;
    color: {{ block.settings.step_text_color }};
    line-height: 1.6;
    margin: 0;
  }
{% endstyle %}

<div class="ai-step-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-step-guide-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-step-guide-header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-step-guide-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-step-guide-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-step-guide-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign step_enabled_key = 'step_' | append: i | append: '_enabled'
          assign step_image_key = 'step_' | append: i | append: '_image'
          assign step_title_key = 'step_' | append: i | append: '_title'
          assign step_text_key = 'step_' | append: i | append: '_text'

          assign step_enabled = block.settings[step_enabled_key]
          assign step_image = block.settings[step_image_key]
          assign step_title = block.settings[step_title_key]
          assign step_text = block.settings[step_text_key]
        %}

        {% if step_enabled %}
          <div class="ai-step-guide-item-{{ ai_gen_id }}">
            <div class="ai-step-guide-image-wrapper-{{ ai_gen_id }}">
              {% if step_image %}
                <img
                  src="{{ step_image | image_url: width: 800 }}"
                  alt="{{ step_title | escape }}"
                  loading="lazy"
                  width="{{ step_image.width }}"
                  height="{{ step_image.height }}"
                >
              {% else %}
                <div class="ai-step-guide-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-step-guide-content-{{ ai_gen_id }}">
              {% if step_title != blank %}
                <h3 class="ai-step-guide-step-title-{{ ai_gen_id }}">{{ step_title }}</h3>
              {% endif %}
              {% if step_text != blank %}
                <div class="ai-step-guide-step-text-{{ ai_gen_id }}">{{ step_text }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

