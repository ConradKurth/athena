{% doc %}
  @prompt
    Please create an icon/ features banner.
    It should allow up to 5 feature columns on desktop.
    It should allow horitonzal auto-scrolling on mobile.
    Each feature should have:
    - An icon field (pick from Shopify icon sets or upload)
    - A text field with options to set paragraph/heading level and font size.
    
    All text and icons should be center aligned., The mobile version should show one feature at a time, and automatically show the next one after a few seconds (add a setting to control how long they show for)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-banner-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-features-banner-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-features-banner-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 30px;
  }

  .ai-features-banner-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .ai-features-banner-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-features-banner-icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    color: {{ block.settings.icon_color }};
  }

  .ai-features-banner-icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-features-banner-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-features-banner-text-{{ ai_gen_id }}--p {
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-features-banner-text-{{ ai_gen_id }}--h1 {
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
  }

  .ai-features-banner-text-{{ ai_gen_id }}--h2 {
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
  }

  .ai-features-banner-text-{{ ai_gen_id }}--h3 {
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
  }

  .ai-features-banner-text-{{ ai_gen_id }}--h4 {
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
  }

  @media screen and (max-width: 989px) {
    .ai-features-banner-grid-{{ ai_gen_id }} {
      display: flex;
      position: relative;
      overflow: hidden;
    }

    .ai-features-banner-item-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
      opacity: 0;
      transition: opacity 0.5s ease-in-out;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
    }

    .ai-features-banner-item-{{ ai_gen_id }}.active {
      opacity: 1;
      position: relative;
    }

    .ai-features-banner-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-features-banner-text-{{ ai_gen_id }}--p,
    .ai-features-banner-text-{{ ai_gen_id }}--h1,
    .ai-features-banner-text-{{ ai_gen_id }}--h2,
    .ai-features-banner-text-{{ ai_gen_id }}--h3,
    .ai-features-banner-text-{{ ai_gen_id }}--h4 {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-features-banner-dots-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
    }

    .ai-features-banner-dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: {{ block.settings.text_color }};
      opacity: 0.3;
      transition: opacity 0.3s ease;
    }

    .ai-features-banner-dot-{{ ai_gen_id }}.active {
      opacity: 1;
    }
  }

  @media screen and (min-width: 990px) {
    .ai-features-banner-dots-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<features-banner-{{ ai_gen_id }} 
  class="ai-features-banner-{{ ai_gen_id }}" 
  data-autoplay-delay="{{ block.settings.autoplay_delay }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-features-banner-container-{{ ai_gen_id }}">
    <div class="ai-features-banner-grid-{{ ai_gen_id }}">
      {% assign active_features = 0 %}
      {% for i in (1..5) %}
        {% liquid
          assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
          assign feature_icon_key = 'feature_' | append: i | append: '_icon'
          assign feature_custom_icon_key = 'feature_' | append: i | append: '_custom_icon'
          assign feature_text_key = 'feature_' | append: i | append: '_text'
          assign feature_text_type_key = 'feature_' | append: i | append: '_text_type'

          assign feature_enabled = block.settings[feature_enabled_key]
          assign feature_icon = block.settings[feature_icon_key]
          assign feature_custom_icon = block.settings[feature_custom_icon_key]
          assign feature_text = block.settings[feature_text_key]
          assign feature_text_type = block.settings[feature_text_type_key]
        %}

        {% if feature_enabled %}
          {% assign active_features = active_features | plus: 1 %}
          <div class="ai-features-banner-item-{{ ai_gen_id }}{% if active_features == 1 %} active{% endif %}" data-feature-index="{{ active_features }}">
            <div class="ai-features-banner-icon-wrapper-{{ ai_gen_id }}">
              {% if feature_custom_icon %}
                <img
                  src="{{ feature_custom_icon | image_url: width: 200 }}"
                  alt="{{ feature_text | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% elsif feature_icon != 'none' %}
                {% case feature_icon %}
                  {% when 'checkmark' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  {% when 'truck' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                    </svg>
                  {% when 'shield' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  {% when 'star' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                  {% when 'gift' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                    </svg>
                  {% when 'heart' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                  {% when 'clock' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  {% when 'refresh' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                  {% when 'lock' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                  {% when 'globe' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                {% endcase %}
              {% endif %}
            </div>

            {% if feature_text != blank %}
              {% case feature_text_type %}
                {% when 'p' %}
                  <p class="ai-features-banner-text-{{ ai_gen_id }} ai-features-banner-text-{{ ai_gen_id }}--p">
                    {{ feature_text }}
                  </p>
                {% when 'h1' %}
                  <h1 class="ai-features-banner-text-{{ ai_gen_id }} ai-features-banner-text-{{ ai_gen_id }}--h1">
                    {{ feature_text }}
                  </h1>
                {% when 'h2' %}
                  <h2 class="ai-features-banner-text-{{ ai_gen_id }} ai-features-banner-text-{{ ai_gen_id }}--h2">
                    {{ feature_text }}
                  </h2>
                {% when 'h3' %}
                  <h3 class="ai-features-banner-text-{{ ai_gen_id }} ai-features-banner-text-{{ ai_gen_id }}--h3">
                    {{ feature_text }}
                  </h3>
                {% when 'h4' %}
                  <h4 class="ai-features-banner-text-{{ ai_gen_id }} ai-features-banner-text-{{ ai_gen_id }}--h4">
                    {{ feature_text }}
                  </h4>
              {% endcase %}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-features-banner-dots-{{ ai_gen_id }}">
      {% for i in (1..active_features) %}
        <div class="ai-features-banner-dot-{{ ai_gen_id }}{% if i == 1 %} active{% endif %}" data-dot-index="{{ i }}"></div>
      {% endfor %}
    </div>
  </div>
</features-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturesBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
        this.isMobile = false;
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-features-banner-item-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-features-banner-dot-{{ ai_gen_id }}');
        this.autoplayDelay = parseInt(this.dataset.autoplayDelay) * 1000;

        this.checkMobile();
        window.addEventListener('resize', () => this.checkMobile());

        if (this.isMobile && this.items.length > 1) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', () => this.checkMobile());
      }

      checkMobile() {
        const wasMobile = this.isMobile;
        this.isMobile = window.innerWidth <= 989;

        if (this.isMobile && !wasMobile && this.items.length > 1) {
          this.startAutoplay();
        } else if (!this.isMobile && wasMobile) {
          this.stopAutoplay();
          this.items.forEach(item => item.classList.remove('active'));
        }
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.showNext();
        }, this.autoplayDelay);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      showNext() {
        this.items[this.currentIndex].classList.remove('active');
        if (this.dots[this.currentIndex]) {
          this.dots[this.currentIndex].classList.remove('active');
        }

        this.currentIndex = (this.currentIndex + 1) % this.items.length;

        this.items[this.currentIndex].classList.add('active');
        if (this.dots[this.currentIndex]) {
          this.dots[this.currentIndex].classList.add('active');
        }
      }
    }

    customElements.define('features-banner-{{ ai_gen_id }}', FeaturesBanner{{ ai_gen_id }});
  })();
</script>

