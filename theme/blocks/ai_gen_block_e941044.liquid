{% doc %}
  @prompt
    generate an accordion faq section that allows me modfy the text as rich text. give me optio t oadd as many faqs as I want , keep formattings like bullets etc in the answers 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-accordion-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-faq-accordion__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.spacing_between_items }}px;
  }

  .ai-faq-accordion__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px 0;
  }

  .ai-faq-accordion__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-faq-accordion__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-faq-accordion__item-{{ ai_gen_id }} {
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin-bottom: {{ block.settings.spacing_between_items }}px;
    overflow: hidden;
    background-color: {{ block.settings.item_background_color }};
  }

  .ai-faq-accordion__question-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.item_padding }}px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.question_color }};
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-faq-accordion__question-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.item_hover_color }};
  }

  .ai-faq-accordion__question-text-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-faq-accordion__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-accordion__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-faq-accordion__item-{{ ai_gen_id }}.active .ai-faq-accordion__icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-accordion__answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.item_padding }}px {{ block.settings.item_padding }}px;
    font-size: {{ block.settings.answer_size }}px;
    color: {{ block.settings.answer_color }};
    line-height: 1.6;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} p {
    margin: 0 0 10px 0;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} ul,
  .ai-faq-accordion__answer-content-{{ ai_gen_id }} ol {
    margin: 0 0 10px 0;
    padding-left: 20px;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} ul:last-child,
  .ai-faq-accordion__answer-content-{{ ai_gen_id }} ol:last-child {
    margin-bottom: 0;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} li {
    margin-bottom: 5px;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} li:last-child {
    margin-bottom: 0;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} strong {
    font-weight: 700;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} em {
    font-style: italic;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} a {
    color: {{ block.settings.answer_color }};
    text-decoration: underline;
  }

  .ai-faq-accordion__answer-content-{{ ai_gen_id }} h1,
  .ai-faq-accordion__answer-content-{{ ai_gen_id }} h2,
  .ai-faq-accordion__answer-content-{{ ai_gen_id }} h3,
  .ai-faq-accordion__answer-content-{{ ai_gen_id }} h4,
  .ai-faq-accordion__answer-content-{{ ai_gen_id }} h5,
  .ai-faq-accordion__answer-content-{{ ai_gen_id }} h6 {
    margin: 0 0 10px 0;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-accordion__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-faq-accordion__question-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.question_size }}px * 0.9);
    }

    .ai-faq-accordion__answer-content-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.answer_size }}px * 0.9);
    }
  }
{% endstyle %}

