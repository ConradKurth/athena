{% doc %}
  @prompt
    Create a blog post hero section that displays the blog title, author, and date overlaid on top of the featured image.
    
    Acceptance criteria:
    - Include settings to control the height and width of the image
    - Include a color overlay with opacity controls to ensure readability of the text
    - Ensure the title, author, date, and featured image imports from the blog post and is correctly linked up.
    - Provide alignment controls for the title (left or center alignment and padding)
    - Ensure automatic responsiveness on different screen sizes and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    height: {{ block.settings.height_mobile }}px;
    overflow: hidden;
    border-radius: {{ settings.radius }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-blog-hero-{{ ai_gen_id }} {
      height: {{ block.settings.height_desktop }}px;
    }
  }

  .ai-blog-hero-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog-hero-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-blog-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-blog-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ block.settings.padding_mobile }}px;
    text-align: {{ block.settings.text_alignment }};
    {% if block.settings.text_alignment == 'center' %}
      align-items: center;
    {% else %}
      align-items: flex-start;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .ai-blog-hero-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_desktop }}px;
    }
  }

  .ai-blog-hero-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_headings_font.family }}, {{ settings.type_headings_font.fallback_families }};
    font-weight: {{ settings.type_headings_font.weight }};
    font-size: {{ block.settings.title_size_mobile }}px;
    line-height: {{ settings.type_headings_font_line_height }};
    letter-spacing: {{ settings.type_headings_font_letter_spacing }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    max-width: {{ block.settings.content_max_width }}px;
    {% if settings.type_headings_font_uppercase == 'uppercase' %}
      text-transform: uppercase;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .ai-blog-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_desktop }}px;
    }
  }

  .ai-blog-hero-meta-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: {{ block.settings.meta_size_mobile }}px;
    line-height: {{ settings.type_body_font_line_height }};
    color: {{ block.settings.text_color }};
    opacity: 0.9;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
      flex-wrap: wrap;
    {% else %}
      justify-content: flex-start;
      flex-wrap: wrap;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .ai-blog-hero-meta-{{ ai_gen_id }} {
      font-size: {{ block.settings.meta_size_desktop }}px;
    }
  }

  .ai-blog-hero-meta-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-blog-hero-meta-separator-{{ ai_gen_id }} {
    opacity: 0.5;
  }

  .ai-blog-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: {{ settings.radius }}px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    z-index: 3;
  }
{% endstyle %}

<div class="ai-blog-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if article.image %}
    <img
      src="{{ article.image | image_url: width: 2000 }}"
      alt="{{ article.image.alt | escape }}"
      loading="lazy"
      width="{{ article.image.width }}"
      height="{{ article.image.height }}"
      class="ai-blog-hero-image-{{ ai_gen_id }}"
    >
  {% else %}
    <div class="ai-blog-hero-image-placeholder-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
    </div>
    <div class="ai-blog-hero-empty-state-{{ ai_gen_id }}">
      Add a featured image to this blog post
    </div>
  {% endif %}

  <div class="ai-blog-hero-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-blog-hero-content-{{ ai_gen_id }}">
    {% if article.title %}
      <h1 class="ai-blog-hero-title-{{ ai_gen_id }}">{{ article.title }}</h1>
    {% endif %}

    <div class="ai-blog-hero-meta-{{ ai_gen_id }}">
      {% if block.settings.show_author and article.author %}
        <div class="ai-blog-hero-meta-item-{{ ai_gen_id }}">
          <span>{{ block.settings.author_label }}</span>
          <span>{{ article.author }}</span>
        </div>
      {% endif %}

      {% if block.settings.show_author and block.settings.show_date and article.author and article.published_at %}
        <span class="ai-blog-hero-meta-separator-{{ ai_gen_id }}">•</span>
      {% endif %}

      {% if block.settings.show_date and article.published_at %}
        <div class="ai-blog-hero-meta-item-{{ ai_gen_id }}">
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
            {{ article.published_at | date: block.settings.date_format }}
          </time>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog post hero",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1900,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1600
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Height (mobile)",
      "default": 400
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Height (desktop)",
      "default": 600
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding (mobile)",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding (desktop)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Content maximum width",
      "default": 800
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Size (desktop)",
      "default": 56
    },
    {
      "type": "header",
      "content": "Meta information"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "text",
      "id": "author_label",
      "label": "Author label",
      "default": "By"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "Date format",
      "default": "%B %d, %Y",
      "info": "Use Liquid date format codes. Examples: %B %d, %Y = January 01, 2024 | %m/%d/%Y = 01/01/2024"
    },
    {
      "type": "range",
      "id": "meta_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Meta size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "meta_size_desktop",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Meta size (desktop)",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Blog post hero"
    }
  ]
}
{% endschema %}
