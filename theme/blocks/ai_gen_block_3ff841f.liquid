{% doc %}
  @prompt
    Create a heading section/ Include settings to modify the heading level
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-heading-block-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: 1.2;
  }

  @media screen and (min-width: 750px) {
    .ai-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-heading-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    {% case block.settings.heading_level %}
      {% when 'h1' %}
        <h1 class="ai-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% when 'h2' %}
        <h2 class="ai-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% when 'h3' %}
        <h3 class="ai-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
      {% when 'h4' %}
        <h4 class="ai-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h4>
      {% when 'h5' %}
        <h5 class="ai-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h5>
      {% when 'h6' %}
        <h6 class="ai-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h6>
    {% endcase %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Heading text"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#193445"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Size on mobile",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Size on desktop",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Heading"
    }
  ],
  "tag": null
}
{% endschema %}
