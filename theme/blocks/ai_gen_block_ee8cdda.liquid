      "id": "text_1",
      "label": "Text",
      "default": "<p>Add your text content here. You can use bullet points:</p><ul><li>First point</li><li>Second point</li><li>Third point</li></ul>"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading",
