{% doc %}
  @prompt
    Create a basic two column layout for text with two rows.
    
    Row 1: A heading (H3)
    Row 2: Paragraph text.
    
    Allow the text to be left or center aligned in each column.
    
    Mobile: Show both columns side by side by default. Offer an option to stack on mobile.
    , Ensure bullets in the paragraph fields are visible
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-text-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-two-column-text__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-two-column-text__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.row_gap }}px;
  }

  .ai-two-column-text__column--left-{{ ai_gen_id }} {
    text-align: {{ block.settings.left_alignment }};
  }

  .ai-two-column-text__column--right-{{ ai_gen_id }} {
    text-align: {{ block.settings.right_alignment }};
  }

  .ai-two-column-text__heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-two-column-text__text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-two-column-text__text-{{ ai_gen_id }} ul,
  .ai-two-column-text__text-{{ ai_gen_id }} ol {
    margin: 0;
    padding-left: 20px;
  }

  .ai-two-column-text__text-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-two-column-text__text-{{ ai_gen_id }} li:last-child {
    margin-bottom: 0;
  }

  .ai-two-column-text__text-{{ ai_gen_id }} ul {
    list-style-type: disc;
  }

  .ai-two-column-text__text-{{ ai_gen_id }} ol {
    list-style-type: decimal;
  }

  @media screen and (max-width: 749px) {
    {% if block.settings.stack_on_mobile %}
      .ai-two-column-text__container-{{ ai_gen_id }} {
        grid-template-columns: 1fr;
      }
    {% endif %}

    .ai-two-column-text__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-two-column-text__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-two-column-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-text__container-{{ ai_gen_id }}">
    <div class="ai-two-column-text__column-{{ ai_gen_id }} ai-two-column-text__column--left-{{ ai_gen_id }}">
      {% if block.settings.left_heading != blank %}
        <h3 class="ai-two-column-text__heading-{{ ai_gen_id }}">
          {{ block.settings.left_heading }}
        </h3>
      {% endif %}
      {% if block.settings.left_text != blank %}
        <div class="ai-two-column-text__text-{{ ai_gen_id }}">
          {{ block.settings.left_text }}
        </div>
      {% endif %}
    </div>

    <div class="ai-two-column-text__column-{{ ai_gen_id }} ai-two-column-text__column--right-{{ ai_gen_id }}">
      {% if block.settings.right_heading != blank %}
        <h3 class="ai-two-column-text__heading-{{ ai_gen_id }}">
          {{ block.settings.right_heading }}
        </h3>
      {% endif %}
      {% if block.settings.right_text != blank %}
        <div class="ai-two-column-text__text-{{ ai_gen_id }}">
          {{ block.settings.right_text }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Two column text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "richtext",
      "id": "left_heading",
      "label": "Heading",
      "default": "<p>Left column heading</p>"
    },
    {
      "type": "richtext",
      "id": "left_text",
      "label": "Text",
      "default": "<p>Add your text content for the left column here. This is a great place to share information with your customers.</p>"
    },
    {
      "type": "select",
      "id": "left_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "richtext",
      "id": "right_heading",
      "label": "Heading",
      "default": "<p>Right column heading</p>"
    },
    {
      "type": "richtext",
      "id": "right_text",
      "label": "Text",
      "default": "<p>Add your text content for the right column here. This is a great place to share information with your customers.</p>"
    },
    {
      "type": "select",
      "id": "right_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Column gap",
      "default": 40
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Row gap",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "Stack columns on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 22
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#193445"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#193445"
    }
  ],
  "presets": [
    {
      "name": "Two column text"
    }
  ]
}
{% endschema %}
