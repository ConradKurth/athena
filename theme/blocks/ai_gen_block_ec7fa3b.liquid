      "default": "Position the biodegradable liner in your toilet bowl before use to create a protective barrier"
    },
    {
      "type": "header",
      "content": "Step 2"
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Title",
      "default": "Protective barrier"
    },
    {
      "type": "textarea",
      "id": "step_2_description",
      "label": "Description",
      "default": "The liner catches waste while preventing splashback and eliminating odors effectively"
    },
    {
      "type": "header",
