            assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
            assign icon_type_key = 'feature_' | append: i | append: '_icon_type'
            assign shopify_icon_key = 'feature_' | append: i | append: '_shopify_icon'
            assign custom_icon_key = 'feature_' | append: i | append: '_custom_icon'
            assign text_key = 'feature_' | append: i | append: '_text'

            assign feature_enabled = block.settings[feature_enabled_key]
            assign icon_type = block.settings[icon_type_key]
            assign shopify_icon = block.settings[shopify_icon_key]
            assign custom_icon = block.settings[custom_icon_key]
            assign text = block.settings[text_key]
          %}

          {% if feature_enabled %}
            <div class="ai-features-banner__mobile-slide-{{ ai_gen_id }}">
              <div class="ai-features-banner__feature-{{ ai_gen_id }}">
                <div class="ai-features-banner__icon-wrapper-{{ ai_gen_id }}">
                  {% if icon_type == 'shopify' %}
