{% doc %}
  @prompt
    Please create a horizontal  icon/ features banner.
    It should allow up to 5 feature columns on desktop.
    It should allow horitonzal auto-scrolling on mobile.
    The section should have an h2 heading first. 
    Then, Each feature should have:
    - An icon field (pick from Shopify icon sets or upload)
    - A text field with options to set paragraph/heading level and font size.
    - a sub-text field with options to set paragraph/heading level and font size.
    All text and icons should be center aligned., The mobile version should show one feature at a time, and automatically show the next one after a few seconds (add a setting to control how long they show for), rmove the liquid error, let me add upto 6 feature columns, keep each feature column - text and subtext centeralligned. also show the scroll dots so user know there are more benefits but the features should keep scrolling automatically, make the dots really small and circular, give options to select feature icon from shopify's exisiting icon set or to upload custom icon for each, show icon instead of the text of icon, keep text and subtext under each logo small and let the width ofthis banner stretch across the width of the page, give option to select size of text and subtext also keep logos size customizable, keep the subtext as wrap text in the mobile version so it is visible in the center of the mobile screen and does not get cut off, wrap the subtext in three lines if it is getting longer for the mobile screen size , removee subtext option from the mobile version
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-banner-{{ ai_gen_id }} {
    padding: 40px 0;
    background-color: {{ block.settings.background_color }};
    width: 100%;
  }

  .ai-features-banner__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 30px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    padding: 0 20px;
  }

  .ai-features-banner__container-{{ ai_gen_id }} {
    width: 100%;
    padding: 0 20px;
  }

  .ai-features-banner__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 30px;
    align-items: start;
  }

  .ai-features-banner__feature-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .ai-features-banner__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-features-banner__icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-features-banner__icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-features-banner__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.3;
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .ai-features-banner__text-{{ ai_gen_id }} h1,
  .ai-features-banner__text-{{ ai_gen_id }} h2,
  .ai-features-banner__text-{{ ai_gen_id }} h3,
  .ai-features-banner__text-{{ ai_gen_id }} h4,
  .ai-features-banner__text-{{ ai_gen_id }} h5,
  .ai-features-banner__text-{{ ai_gen_id }} h6,
  .ai-features-banner__text-{{ ai_gen_id }} p {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
  }

  .ai-features-banner__subtext-{{ ai_gen_id }} {
    color: {{ block.settings.subtext_color }};
    margin: 0;
    font-size: {{ block.settings.subtext_size }}px;
    line-height: 1.4;
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .ai-features-banner__subtext-{{ ai_gen_id }} h1,
  .ai-features-banner__subtext-{{ ai_gen_id }} h2,
  .ai-features-banner__subtext-{{ ai_gen_id }} h3,
  .ai-features-banner__subtext-{{ ai_gen_id }} h4,
  .ai-features-banner__subtext-{{ ai_gen_id }} h5,
  .ai-features-banner__subtext-{{ ai_gen_id }} h6,
  .ai-features-banner__subtext-{{ ai_gen_id }} p {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
  }

  @media screen and (max-width: 749px) {
    .ai-features-banner__grid-{{ ai_gen_id }} {
      display: none;
    }

    .ai-features-banner__mobile-carousel-{{ ai_gen_id }} {
      position: relative;
      overflow: hidden;
      display: block;
    }

    .ai-features-banner__mobile-track-{{ ai_gen_id }} {
      display: flex;
      transition: transform 0.5s ease;
    }

    .ai-features-banner__mobile-slide-{{ ai_gen_id }} {
      min-width: 100%;
      flex-shrink: 0;
      padding: 0 20px;
    }

    .ai-features-banner__text-{{ ai_gen_id }} {
      max-width: 100%;
      white-space: normal;
    }

    .ai-features-banner__subtext-{{ ai_gen_id }} {
      display: none;
    }

    .ai-features-banner__dots-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
    }

    .ai-features-banner__dot-{{ ai_gen_id }} {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: {{ block.settings.dot_color }};
      opacity: 0.3;
      transition: opacity 0.3s ease;
    }

    .ai-features-banner__dot-{{ ai_gen_id }}.active {
      opacity: 1;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-features-banner__mobile-carousel-{{ ai_gen_id }} {
      display: none;
    }

    .ai-features-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-features-banner__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_desktop }}px;
    }

    .ai-features-banner__subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size_desktop }}px;
    }

    .ai-features-banner__icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_desktop }}px;
      height: {{ block.settings.icon_size_desktop }}px;
    }
  }
{% endstyle %}

