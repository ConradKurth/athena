    {
      "type": "header",
      "content": "Product colors"
    },
    {
      "type": "color",
      "id": "product_background",
      "label": "Background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "vendor_color",
      "label": "Vendor",
      "default": "#717171"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#193445"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star filled",
      "default": "#fcc97e"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Star empty",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "rating_count_color",
      "label": "Rating count",
      "default": "#717171"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description",
      "default": "#717171"
    },
    {
      "type": "color",
      "id": "product_button_bg",
      "label": "Button background",
      "default": "#003649"
    },
    {
      "type": "color",
      "id": "product_button_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "product_button_bg_hover",
      "label": "Button hover background",
      "default": "#005c7c"
    },
    {
      "type": "color",
      "id": "product_button_color_hover",
      "label": "Button hover text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Two column image product"
    }
  ]
}
{% endschema %}
