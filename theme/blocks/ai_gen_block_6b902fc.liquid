          {%- if block.settings.linkedin_url != blank -%}
            <a href="{{ block.settings.linkedin_url }}" class="ai-custom-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg class="ai-custom-footer-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
