{% doc %}
  @prompt
    generate a new Shopify section called custom-footer.liquid.
    The design must match the footer layout shown here:
    
    Column 1 – Brand Info
    
    Large heading for the brand name (e.g., “UraGuard®”)
    
    Short text description paragraph
    
    Column 2 – Newsletter Signup
    
    A heading “Newsletter”
    
    Subtext “Subscribe to get special offers and updates.”
    
    Name field
    
    Email field
    
    A rounded button with arrow icon
    
    Use Shopify’s built-in form tag so emails go to the customer list
    
    Column 3 – Quick Links
    
    Heading “Quick Links”
    
    List of links editable in the theme editor (minimum 8–12 links)
    
    Column 4 – Social
    
    Heading “Social”
    
    Email or contact text
    
    Social icons (Instagram, Facebook) with URLs editable in theme settings
    
    Design Requirements:
    
    Layout should be a 3 or 4-column responsive grid on desktop
    
    On mobile: stack the columns vertically
    
    Background color setting (default dark blue like #11293f)
    
    Text color and heading color settings
    
    Button with smooth hover effect
    
    Columns should have vertical spacing similar to the screenshot
    
    Section width should match a standard Shopify container (max-width ~1200px)
    
    Font sizes:
    
    Headings: 26–32px
    
    Body text: 14–16px
    
    Quick link list: 14–16px
    
    Schema Requirements:
    Add fields so the merchant can edit:
    
    Brand title
    
    Brand description
    
    Newsletter heading
    
    Newsletter subtext
    
    Link list picker for “Quick Links”
    
    Social links (Instagram, Facebook)
    
    Contact email
    
    Background color
    
    Text color
    
    Heading color, for the newsletter column, keep the heading then the text line
    
    then have two fields to enter name and email id in two rows
    
    foloow it iwth a button with text on it. Clicking on it should display success message with editable text, remmove all this from form signup
    
    UraGuard®, give option to edit color of susbscribe button , under social add icons for insstagram facebook etc
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-footer-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: 60px 20px 40px;
  }

  .ai-custom-footer-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-custom-footer-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-bottom: 40px;
  }

  .ai-custom-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-custom-footer-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 8px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-custom-footer-brand-description-{{ ai_gen_id }} {
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-custom-footer-column-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    font-weight: 700;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-custom-footer-newsletter-subtext-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }

  .ai-custom-footer-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-custom-footer-input-{{ ai_gen_id }} {
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font-size: 14px;
    width: 100%;
  }

  .ai-custom-footer-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
  }

  .ai-custom-footer-button-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.subscribe_button_color }};
    color: {{ block.settings.subscribe_button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background-color 0.3s ease, transform 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-custom-footer-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.subscribe_button_hover_color }};
    transform: translateY(-2px);
  }

  .ai-custom-footer-links-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ai-custom-footer-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: 15px;
    transition: color 0.3s ease;
  }

  .ai-custom-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-custom-footer-contact-{{ ai_gen_id }} {
    font-size: 15px;
    margin-bottom: 16px;
  }

  .ai-custom-footer-social-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-custom-footer-social-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.social_icon_background }};
    color: {{ block.settings.social_icon_color }};
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-custom-footer-social-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.social_icon_hover_background }};
    transform: translateY(-3px);
  }

  .ai-custom-footer-social-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
  }

  .ai-custom-footer-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    margin-top: 8px;
    font-size: 14px;
  }

  .ai-custom-footer-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    margin-top: 8px;
    font-size: 14px;
  }

  @media screen and (max-width: 990px) {
    .ai-custom-footer-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-custom-footer-{{ ai_gen_id }} {
      padding: 40px 20px 30px;
    }

    .ai-custom-footer-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-custom-footer-heading-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-custom-footer-column-heading-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<footer class="ai-custom-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-footer-container-{{ ai_gen_id }}">
    <div class="ai-custom-footer-grid-{{ ai_gen_id }}">
      <div class="ai-custom-footer-column-{{ ai_gen_id }}">
        {%- if block.settings.brand_title != blank -%}
          <h2 class="ai-custom-footer-heading-{{ ai_gen_id }}">{{ block.settings.brand_title }}</h2>
        {%- endif -%}
        {%- if block.settings.brand_description != blank -%}
          <div class="ai-custom-footer-brand-description-{{ ai_gen_id }}">
            {{ block.settings.brand_description }}
          </div>
        {%- endif -%}
      </div>

      <div class="ai-custom-footer-column-{{ ai_gen_id }}">
        {%- if block.settings.newsletter_heading != blank -%}
          <h3 class="ai-custom-footer-column-heading-{{ ai_gen_id }}">{{ block.settings.newsletter_heading }}</h3>
        {%- endif -%}
        {%- if block.settings.newsletter_subtext != blank -%}
          <p class="ai-custom-footer-newsletter-subtext-{{ ai_gen_id }}">{{ block.settings.newsletter_subtext }}</p>
        {%- endif -%}
        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="ai-custom-footer-form-{{ ai_gen_id }}">
            <input
              type="text"
              name="contact[first_name]"
              class="ai-custom-footer-input-{{ ai_gen_id }}"
              placeholder="Name"
              autocomplete="given-name"
            >
            <input
              type="email"
              name="contact[email]"
              class="ai-custom-footer-input-{{ ai_gen_id }}"
              placeholder="Email"
              autocomplete="email"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-custom-footer-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-custom-footer-success-{{ ai_gen_id }}"
              {% endif %}
            >
            <button type="submit" class="ai-custom-footer-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>
            {%- if form.errors -%}
              <div id="ai-custom-footer-error-{{ ai_gen_id }}" class="ai-custom-footer-error-{{ ai_gen_id }}">
                {{ form.errors.messages.email }}
              </div>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <div id="ai-custom-footer-success-{{ ai_gen_id }}" class="ai-custom-footer-success-{{ ai_gen_id }}">
                {{ block.settings.success_message }}
              </div>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>

      <div class="ai-custom-footer-column-{{ ai_gen_id }}">
        {%- if block.settings.quick_links_heading != blank -%}
          <h3 class="ai-custom-footer-column-heading-{{ ai_gen_id }}">{{ block.settings.quick_links_heading }}</h3>
        {%- endif -%}
        {%- if block.settings.quick_links != blank -%}
          <ul class="ai-custom-footer-links-list-{{ ai_gen_id }}">
            {%- for link in block.settings.quick_links.links -%}
              <li>
                <a href="{{ link.url }}" class="ai-custom-footer-link-{{ ai_gen_id }}">
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="ai-custom-footer-column-{{ ai_gen_id }}">
        {%- if block.settings.social_heading != blank -%}
          <h3 class="ai-custom-footer-column-heading-{{ ai_gen_id }}">{{ block.settings.social_heading }}</h3>
        {%- endif -%}
        {%- if block.settings.contact_email != blank -%}
          <div class="ai-custom-footer-contact-{{ ai_gen_id }}">
            {{ block.settings.contact_email }}
          </div>
        {%- endif -%}
        <div class="ai-custom-footer-social-icons-{{ ai_gen_id }}">
          {%- if block.settings.instagram_url != blank -%}
            <a href="{{ block.settings.instagram_url }}" class="ai-custom-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg class="ai-custom-footer-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
