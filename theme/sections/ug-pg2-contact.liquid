{%- render 'ug-pg2-head' -%}
<div class="ug ugp">
  <section class="sec ugp-contact">
    <div class="w ugp-contact-g">
      <div class="card ugp-form">
        <h2>{{ section.settings.form_heading }}</h2>
        {%- if section.settings.form_text != blank -%}<p class="lead">{{ section.settings.form_text }}</p>{%- endif -%}
        {%- form 'contact', id: 'ugp-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="ugp-ok" role="status">{% render 'ug-pg2-icon', i: 'tick' %}{{ section.settings.success }}</p>
          {%- endif -%}
          {%- if form.errors -%}<div class="ugp-err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="row2">
            <div class="fld"><label for="ugc-name">Name</label><input id="ugc-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
            <div class="fld"><label for="ugc-email">Email <span class="req" aria-hidden="true">*</span></label><input id="ugc-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
          </div>
          <div class="fld"><label for="ugc-phone">Phone <span class="opt">(optional)</span></label><input id="ugc-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
          <div class="fld"><label for="ugc-body">How can we help? <span class="req" aria-hidden="true">*</span></label><textarea id="ugc-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea></div>
          <button type="submit" class="btn btn-main">{{ section.settings.button }}</button>
        {%- endform -%}
      </div>
      <aside class="ugp-aside">
        <div class="card ugp-help">
          <span class="ic">{% render 'ug-pg2-icon', i: 'mail' %}</span>
          <h3>{{ section.settings.side_heading }}</h3>
          {%- if section.settings.side_text != blank -%}<p>{{ section.settings.side_text }}</p>{%- endif -%}
          <a class="tlink" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
        </div>
        {%- if section.blocks.size > 0 -%}
          <div class="card ugp-links">
            <h3>{{ section.settings.links_heading }}</h3>
            <ul>
              {%- for block in section.blocks -%}
                <li {{ block.shopify_attributes }}><a href="{{ block.settings.link }}"><span>{{ block.settings.label }}</span>{% render 'ug-pg2-icon', i: 'arrow' %}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </aside>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "UraGuard contact",
  "tag": "section",
  "class": "section-ug-pg2-contact",
  "settings": [
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "text", "id": "form_text", "label": "Form text" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thank you. Your message has been sent." },
    { "type": "text", "id": "side_heading", "label": "Email card heading", "default": "Prefer email?" },
    { "type": "text", "id": "side_text", "label": "Email card text" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@athenauraguard.com" },
    { "type": "text", "id": "links_heading", "label": "Links heading", "default": "Quick answers" }
  ],
  "blocks": [
    { "type": "link", "name": "Link", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "UraGuard contact" }]
}
{% endschema %}