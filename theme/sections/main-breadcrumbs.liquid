{% assign background_rgb = section.settings.background_color | color_to_rgb %}
{% assign text_rgb = section.settings.text_color | color_to_rgb %}

<style>
  [data-section-id="{{ section.id }}"]{

    {% if background_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --color-custom-background: {{ section.settings.background_color }};
    {% endif %}

    {% if text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --color-custom-text: {{ section.settings.text_color }};
      --color-links: {{ section.settings.text_color }};
    {% endif %}

    {% if section.settings.margin-top %}
        --section-gap-top: {{ section.settings.margin-top }}px;
    {% endif %}

    {% if section.settings.margin-bottom %}
        --section-gap-bottom: {{ section.settings.margin-bottom }}px;
    {% endif %}
  }
</style>
<div class="breadcrumbs__wrapper" data-section-id="{{ section.id }}">
  <div class="breadcrumbs {% if section.settings.full-width-enabled %}breadcrumbs--full-width{% endif %}">
    <ul class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="{{ shop.url }}" class="breadcrumbs__link">{{ 'homepage' | t }}</a>
      </li>
      {%- if blog and article -%}
        <li class="breadcrumbs__item">
          {{ blog.title | link_to: blog.url, class: 'breadcrumbs__link' }}
        </li>
        <li class="breadcrumbs__item">{{ article.title }}</li>
      {%- elsif product -%}
        {%- assign first_collection = product.collections[0] -%}
        {%- if first_collection.url -%}
          <li class="breadcrumbs__item">
            {{ first_collection.title | link_to: first_collection.url, class: 'breadcrumbs__link' }}
          </li>
        {%- endif -%}
        <li class="breadcrumbs__item">{{ product.title }}</li>
      {%- elsif collection -%}
        <li class="breadcrumbs__item">{{ collection.title }}</li>
      {%- elsif page -%}
        <li class="breadcrumbs__item">{{ page.title }}</li>
      {%- endif -%}
    </ul>
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ 'homepage' | t | json }}, "item": {{ shop.url | json }} }
    {%- if blog and article %},
    { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
    {%- elsif product %}
      {%- assign first_collection = product.collections[0] -%}
      {%- if first_collection.url %},
    { "@type": "ListItem", "position": 2, "name": {{ first_collection.title | json }}, "item": {{ request.origin | append: first_collection.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- else %},
    { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- endif %}
    {%- elsif collection %},
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
    {%- elsif page %},
    { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ request.origin | append: page.url | json }} }
    {%- endif %}
  ]
}
</script>

{% schema %}
{
  "name": "t:sections.main-breadcrumbs.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-breadcrumbs.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "full-width-enabled",
      "label": "t:sections.settings.settings.section-full-width.label",
      "info": "t:sections.main-breadcrumbs.settings.full-width-enabled.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "transparent",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "transparent",
      "label": "t:sections.settings.settings.background-color.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 8,
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 8,
      "label": "t:sections.settings.settings.distance-bottom.label",
      "info": "t:sections.settings.settings.distance-bottom.info"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
