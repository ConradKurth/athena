{%- comment -%}UraGuard content page: hero, story, evidence and shop blocks in the homepage design.{%- endcomment -%}
{%- assign product = all_products['athena-uraguard-liner'] -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
{{ 'uraguard-home.css' | asset_url | stylesheet_tag }}
{{ 'ug-pg1.css' | asset_url | stylesheet_tag }}
<style>
{%- include 'ug-home-style' -%}
</style>
<div class="ug ug-pg">
{%- for block in section.blocks -%}
{%- render 'ug-pg1-block', block: block, product: product -%}
{%- endfor -%}
</div>

