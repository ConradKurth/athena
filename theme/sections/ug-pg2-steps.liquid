{%- render 'ug-pg2-head' -%}
<div class="ug ugp">
  <section class="sec ugp-stepsec">
    <div class="w">
      {%- if section.settings.heading != blank -%}
        <div class="head"><div>
          {%- if section.settings.eyebrow != blank -%}<span class="lbl">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}<div class="sub">{{ section.settings.text }}</div>{%- endif -%}
        </div></div>
      {%- endif -%}
      <ol class="ugp-steps">
        {%- for block in section.blocks -%}
          <li class="card ugp-step" {{ block.shopify_attributes }}>
            <div class="im">
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 280px, 40vw', alt: block.settings.title }}{%- endif -%}
            </div>
            <div class="bd">
              <span class="n" aria-hidden="true">{{ forloop.index }}</span>
              <h3><span class="vh">Step {{ forloop.index }}: </span>{{ block.settings.title }}</h3>
              <div class="tx">{{ block.settings.text }}</div>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>

  {%- if section.settings.place_heading != blank -%}
  <section class="ugp-place" id="ugp-place">
    <div class="w ugp-place-g">
      <div class="mvid">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
        {%- elsif section.settings.place_image != blank -%}
          {{ section.settings.place_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.place_heading }}
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.place_eyebrow != blank -%}<span class="lbl">{{ section.settings.place_eyebrow }}</span>{%- endif -%}
        <h2 class="h2">{{ section.settings.place_heading }}</h2>
        {%- if section.settings.place_text != blank -%}<div class="sub">{{ section.settings.place_text }}</div>{%- endif -%}
        <ul class="ugp-checks">
          {%- for n in (1..4) -%}
            {%- assign key = 'check_' | append: n -%}
            {%- assign c = section.settings[key] -%}
            {%- if c != blank -%}<li><span class="ic">{% render 'ug-pg2-icon', i: 'tick' %}</span><span>{{ c }}</span></li>{%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if section.settings.brands != blank -%}
          <div class="ugp-brands"><span>Works inside</span>{%- assign bs = section.settings.brands | split: ',' -%}{%- for b in bs -%}<span class="b">{{ b | strip }}</span>{%- endfor -%}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "UraGuard steps",
  "tag": "section",
  "class": "section-ug-pg2-steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "header", "content": "Placement panel" },
    { "type": "text", "id": "place_eyebrow", "label": "Small label" },
    { "type": "text", "id": "place_heading", "label": "Heading", "info": "Leave blank to hide the panel." },
    { "type": "richtext", "id": "place_text", "label": "Text" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "image_picker", "id": "place_image", "label": "Image (used if no video)" },
    { "type": "text", "id": "check_1", "label": "Point 1" },
    { "type": "text", "id": "check_2", "label": "Point 2" },
    { "type": "text", "id": "check_3", "label": "Point 3" },
    { "type": "text", "id": "check_4", "label": "Point 4" },
    { "type": "text", "id": "brands", "label": "Brands (comma separated)" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "UraGuard steps" }]
}
{% endschema %}