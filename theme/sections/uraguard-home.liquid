{%- comment -%}
  UraGuard homepage. One section file used twice on the homepage:
  part "top" (hero to shop and reviews header) and part "bottom" (evidence, audiences, questions),
  with the Judge.me review carousel placed between them. Markup lives in snippets ug-home-a, c, r, h, b, d and e.
  Order: hero + UTI problem (a) → what is a hygiene shield, the solution (c) → 96% result (r) → how to use (h) → why it matters (b) → reviews (d).
  The 96% lab claim is kept away from UTI/infection wording: "what is a hygiene shield" sits above it and "how to use" below it.
{%- endcomment -%}
{%- assign product = section.settings.product | default: all_products['athena-uraguard-liner'] -%}
{%- assign from_price = product.price_min | money_without_trailing_zeros | default: '$29' -%}
{%- assign rating = product.metafields.reviews.rating.value.rating | default: 4.67 | round: 1 -%}
{%- assign rating_count = product.metafields.reviews.rating_count.value | default: 89 -%}
{%- capture star -%}<svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path fill="currentColor" d="M10 1.6l2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.5l-5.1 2.8 1.1-5.7-4.3-4 5.8-.7z"/></svg>{%- endcapture -%}
{%- capture stars -%}<span class="ug-stars" aria-hidden="true">{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span>{%- endcapture -%}
{%- capture tick -%}<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{%- endcapture -%}
{%- capture i_ship -%}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="15" height="11" rx="1"/><path d="M16 9h4l3 3v5h-7"/><circle cx="6" cy="18.5" r="1.8"/><circle cx="18" cy="18.5" r="1.8"/></svg>{%- endcapture -%}
{%- capture i_return -%}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 3 3 9 9 9"/></svg>{%- endcapture -%}
{%- capture i_card -%}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>{%- endcapture -%}
{%- capture i_shield -%}<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21.5s7.5-3.6 7.5-9.6V5.3L12 2.5 4.5 5.3v6.6c0 6 7.5 9.6 7.5 9.6z"/><polyline points="9 12 11 14 15 10"/></svg>{%- endcapture -%}
{%- capture i_lab -%}<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10 3v6L4.5 19a1.5 1.5 0 0 0 1.3 2h12.4a1.5 1.5 0 0 0 1.3-2L14 9V3"/></svg>{%- endcapture -%}
{%- capture i_doc -%}<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v6a5 5 0 0 0 10 0V3"/><path d="M11 14v2a5 5 0 0 0 10 0v-3"/><circle cx="21" cy="11" r="2"/></svg>{%- endcapture -%}
{%- capture i_flag -%}<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22V4"/><path d="M4 4h13l-2 4 2 4H4"/></svg>{%- endcapture -%}
{%- capture cta -%}<div class="cta-row"><a class="btn btn-main" href="{{ product.url | default: '/products/athena-uraguard-liner' }}">Shop UraGuard®</a><span>{{ i_return }}Free 30-day returns · Free shipping</span></div>{%- endcapture -%}

{%- if section.settings.part == 'top' -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
{{ 'uraguard-home.css' | asset_url | stylesheet_tag }}
<style>
{%- include 'ug-home-style' -%}
</style>
{%- endif -%}

<div class="ug">
{%- if section.settings.part == 'top' -%}
{%- include 'ug-home-a' -%}
{%- include 'ug-home-c' -%}
{%- include 'ug-home-r' -%}
{%- include 'ug-home-h' -%}
{%- include 'ug-home-b' -%}
{%- include 'ug-home-d' -%}
{%- else -%}
{%- include 'ug-home-e' -%}
{%- endif -%}
</div>

{% schema %}
{
  "name": "UraGuard homepage",
  "tag": "section",
  "class": "section-uraguard-home",
  "settings": [
    { "type": "select", "id": "part", "label": "Which part of the homepage", "options": [ { "value": "top", "label": "Top: hero to reviews" }, { "value": "bottom", "label": "Bottom: evidence to questions" } ], "default": "top" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero photo (shield going into a brief)" },
    { "type": "checkbox", "id": "hero_crop", "label": "Crop to the right-hand side of the photo", "info": "On for the 'Briefs hold bacteria' graphic, which has text built in. Off for a clean photo.", "default": true },
    { "type": "header", "content": "Videos" },
    { "type": "video", "id": "placement_video", "label": "Placement video (shield going into each brief)" },
    { "type": "video", "id": "science_video", "label": "Science animation" },
    { "type": "header", "content": "Steps" },
    { "type": "paragraph", "content": "Step photos come from Files named uraguard-step-1-peel.jpg, uraguard-step-2-place.jpg, uraguard-step-3-press.jpg and uraguard-step-4-remove.jpg when present; otherwise these are used." },
    { "type": "image_picker", "id": "step_1", "label": "Step 1 image" },
    { "type": "image_picker", "id": "step_2", "label": "Step 2 image" },
    { "type": "image_picker", "id": "step_3", "label": "Step 3 image" },
    { "type": "image_picker", "id": "step_4", "label": "Step 4 image" },
    { "type": "header", "content": "Video reviews" },
    { "type": "video", "id": "video_1", "label": "Video review 1" },
    { "type": "text", "id": "video_1_name", "label": "Name", "default": "Rebekah" },
    { "type": "text", "id": "video_1_note", "label": "Note", "default": "UraGuard customer" },
    { "type": "video", "id": "video_2", "label": "Video review 2" },
    { "type": "text", "id": "video_2_name", "label": "Name", "default": "Karen" },
    { "type": "text", "id": "video_2_note", "label": "Note", "default": "Cares for her mom" },
    { "type": "header", "content": "Evidence and audiences" },
    { "type": "image_picker", "id": "doctor_image", "label": "Doctor photo" },
    { "type": "image_picker", "id": "her_image", "label": "'I wear briefs' photo" },
    { "type": "image_picker", "id": "caregiver_image", "label": "'I care for someone' photo" },
    { "type": "url", "id": "caregiver_link", "label": "Caregiver guide link" },
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product" }
  ],
  "presets": [{ "name": "UraGuard homepage" }]
}
{% endschema %}